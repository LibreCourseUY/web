---
import Layout from '@/layouts/Layout.astro';
import Text from '@/components/Text/Text.astro';
import Anchor from '@/components/Anchor/Anchor.astro';
import { communityLinks } from '@/data/community';
import { sortEntries } from '@/lib/awesome';
import { fetchCatalogueForBuild } from '@/lib/catalogue-build';
import { projectGroupsHtml, projectsItemList } from '@/lib/catalogue-render';

// Prerender the catalogue so crawlers (and visitors without JS) get real
// content; the client script refreshes it and adds filtering.
const feed = await fetchCatalogueForBuild();
const entries = feed ? sortEntries(feed.entries) : [];
const groupsHtml = feed ? projectGroupsHtml(feed.categories, entries) : '';
---

<Layout
  title="Open Source Projects from Uruguay — LibreCourseUY"
  description="Browse open source and community projects from LibreCourseUY: filter by category, language, licence and whether maintainers are open to contributions."
>
  <main class="flex min-h-screen flex-col items-start justify-center">
    <section class="flex w-full flex-col justify-start items-start gap-8 pt-12 pb-12">
      <div class="space-y-4">
        <Text variant="h1">Projects</Text>
        <Text variant="p" class="text-muted max-w-3xl">
          Curated projects from the LibreCourseUY community. Search, filter and find something to
          contribute to.
        </Text>
      </div>

      <nav aria-label="Explore the community" class="flex flex-wrap gap-x-6 gap-y-4">
        <Anchor href="/showcase/" className="text-sm font-bold underline underline-offset-4">
          Discover member products <span aria-hidden="true">→</span>
        </Anchor>
        <Anchor href="/orgs/" className="text-sm font-bold underline underline-offset-4">
          Meet the organizations <span aria-hidden="true">→</span>
        </Anchor>
        <Anchor
          href={communityLinks.activity}
          className="text-sm font-bold underline underline-offset-4"
        >
          Follow activity on Gitsion <span aria-hidden="true">↗</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </Anchor>
        <Anchor href="/contribute/" className="text-sm font-bold underline underline-offset-4">
          First contribution guide <span aria-hidden="true">→</span>
        </Anchor>
      </nav>

      <div id="awesome-app" class="w-full" hidden={!feed}>
        <div
          class="flex flex-col gap-4 border-y border-line py-6 md:flex-row md:flex-wrap md:items-end"
        >
          <label class="flex min-w-56 flex-1 flex-col gap-1">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">Search</span>
            <input
              id="awesome-search"
              type="search"
              placeholder="Name, description, tag or maintainer..."
              class="w-full border border-line bg-surface px-3 py-2 text-sm text-emphasis outline-none focus:border-emphasis-secondary"
            />
          </label>

          <label class="flex min-w-44 flex-col gap-1">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">Category</span>
            <select
              id="awesome-category"
              class="border border-line bg-surface px-3 py-2 text-sm text-emphasis outline-none focus:border-emphasis-secondary"
            ></select>
          </label>

          <label class="flex min-w-44 flex-col gap-1">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">Commercial</span>
            <select
              id="awesome-commercial"
              class="border border-line bg-surface px-3 py-2 text-sm text-emphasis outline-none focus:border-emphasis-secondary"
            >
              <option value="">Any</option>
              <option value="non-commercial">Non-commercial</option>
              <option value="commercial">Commercial</option>
            </select>
          </label>

          <label class="flex min-w-44 flex-col gap-1">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">Language</span>
            <select
              id="awesome-language"
              class="border border-line bg-surface px-3 py-2 text-sm text-emphasis outline-none focus:border-emphasis-secondary"
            ></select>
          </label>

          <label class="flex min-w-40 flex-col gap-1">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">Contributions</span>
            <select
              id="awesome-contrib"
              class="border border-line bg-surface px-3 py-2 text-sm text-emphasis outline-none focus:border-emphasis-secondary"
            >
              <option value="">Any</option>
              <option value="open">Open</option>
              <option value="closed">Closed</option>
            </select>
          </label>

          <button
            id="awesome-reset"
            type="button"
            class="border border-line px-4 py-2 text-sm font-bold text-muted transition-colors hover:border-emphasis-secondary hover:text-emphasis"
          >
            Reset
          </button>
        </div>

        <p id="awesome-count" class="pt-4 text-xs uppercase tracking-wider text-muted">
          {feed ? `${entries.length} of ${feed.entries.length} projects` : ''}
        </p>

        <div id="awesome-grid" class="space-y-10 pt-4" set:html={groupsHtml} />

        <p id="awesome-empty" class="hidden py-16 text-center text-muted" hidden>
          No projects match your filters.
        </p>
      </div>

      <div id="awesome-maintenance" class="w-full border border-line bg-surface p-8" hidden>
        <Text variant="h3">Project directory temporarily unavailable</Text>
        <Text variant="p" class="mt-3 max-w-2xl text-muted">
          You can still explore community projects and open tasks on
          <Anchor href={communityLinks.activity} className="text-base text-inherit underline"
            >Gitsion</Anchor
          >, or <Anchor href={communityLinks.discord} className="text-base text-inherit underline"
            >ask in Discord</Anchor
          >
          for help finding a project.
        </Text>
      </div>

      <div
        id="awesome-loading"
        class="w-full py-16 text-center text-xs uppercase tracking-wider text-muted"
        hidden={Boolean(feed)}
      >
        Loading projects...
      </div>
    </section>
  </main>
  {
    feed && feed.entries.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(projectsItemList(entries, 'https://librecourse.uy'))}
      />
    )
  }
</Layout>

<script>
  import { sortEntries, uniqueValues } from '@/lib/awesome';
  import { loadAwesomeFeed } from '@/lib/awesome-client';
  import { projectGroupsHtml } from '@/lib/catalogue-render';
  import type { AwesomeEntry, AwesomeFilters } from '@/lib/awesome';

  const app = document.getElementById('awesome-app') as HTMLElement | null;
  const grid = document.getElementById('awesome-grid');
  const count = document.getElementById('awesome-count');
  const empty = document.getElementById('awesome-empty');
  const maintenance = document.getElementById('awesome-maintenance');
  const loading = document.getElementById('awesome-loading');
  const search = document.getElementById('awesome-search') as HTMLInputElement | null;
  const categoryEl = document.getElementById('awesome-category') as HTMLSelectElement | null;
  const commercialEl = document.getElementById('awesome-commercial') as HTMLSelectElement | null;
  const languageEl = document.getElementById('awesome-language') as HTMLSelectElement | null;
  const contribEl = document.getElementById('awesome-contrib') as HTMLSelectElement | null;
  const resetEl = document.getElementById('awesome-reset');

  interface FilterRow {
    el: HTMLElement;
    haystack: string;
    category: string;
    languages: string[];
    commercial: number;
    openToContributions: number;
  }

  let rows: FilterRow[] = [];
  let total = 0;

  // The server renders every card with its filter metadata, so the page is
  // usable before (and without) the feed fetch.
  function collectRows(): void {
    if (!grid) return;
    rows = [...grid.querySelectorAll<HTMLElement>('[data-filter]')].map((el) => {
      const raw = el.dataset.filter ?? '{}';
      let data: Record<string, unknown> = {};
      try {
        data = JSON.parse(raw);
      } catch {
        /* malformed metadata: treat as unfilterable */
      }
      const text = [
        data.n,
        data.d,
        data.c,
        ...((data.t as string[]) ?? []),
        ...((data.m as string[]) ?? []),
      ]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();
      return {
        el,
        haystack: text,
        category: String(data.c ?? ''),
        languages: ((data.l as string[]) ?? []).map((l) => l.toLowerCase()),
        commercial: Number(data.com) || 0,
        openToContributions: Number(data.o) || 0,
      };
    });
    total = rows.length;
  }

  function fillSelect(el: HTMLSelectElement | null, label: string, values: string[]) {
    if (!el) return;
    const current = el.value;
    el.innerHTML =
      `<option value="">Any ${label}</option>` +
      values.map((v) => `<option value="${v.replace(/"/g, '&quot;')}">${v}</option>`).join('');
    el.value = current;
  }

  function readState(): AwesomeFilters {
    return {
      query: search?.value ?? '',
      categories: categoryEl?.value ? [categoryEl.value] : [],
      commercial:
        commercialEl?.value === 'commercial'
          ? true
          : commercialEl?.value === 'non-commercial'
            ? false
            : null,
      languages: languageEl?.value ? [languageEl.value] : [],
      openToContributions:
        contribEl?.value === 'open' ? true : contribEl?.value === 'closed' ? false : null,
    };
  }

  function writeUrl() {
    const params = new URLSearchParams();
    const state = readState();
    if (state.query) params.set('q', state.query);
    if (state.categories?.[0]) params.set('category', state.categories[0]);
    if (state.commercial !== null && state.commercial !== undefined)
      params.set('commercial', state.commercial ? 'commercial' : 'non-commercial');
    if (state.languages?.[0]) params.set('language', state.languages[0]);
    if (state.openToContributions !== null && state.openToContributions !== undefined)
      params.set('contrib', state.openToContributions ? 'open' : 'closed');
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function readUrl() {
    const params = new URLSearchParams(location.search);
    if (search && params.get('q')) search.value = params.get('q')!;
    if (categoryEl && params.get('category')) categoryEl.value = params.get('category')!;
    if (commercialEl && params.get('commercial')) commercialEl.value = params.get('commercial')!;
    if (languageEl && params.get('language')) languageEl.value = params.get('language')!;
    if (contribEl && params.get('contrib')) contribEl.value = params.get('contrib')!;
  }

  function applyFilters(): void {
    const state = readState();
    const query = (state.query ?? '').trim().toLowerCase();
    let visible = 0;

    for (const row of rows) {
      const matchQuery = !query || row.haystack.includes(query);
      const matchCategory = !state.categories?.length || state.categories.includes(row.category);
      const matchLanguage =
        !state.languages?.length ||
        state.languages.some((l) => row.languages.includes(l.toLowerCase()));
      const matchCommercial =
        state.commercial === null || state.commercial === undefined
          ? true
          : row.commercial === (state.commercial ? 1 : 0);
      const matchContrib =
        state.openToContributions === null || state.openToContributions === undefined
          ? true
          : row.openToContributions === (state.openToContributions ? 1 : 0);

      const show = matchQuery && matchCategory && matchLanguage && matchCommercial && matchContrib;
      row.el.hidden = !show;
      if (show) visible += 1;
    }

    for (const section of grid?.querySelectorAll('section') ?? []) {
      section.hidden = !section.querySelector('[data-filter]:not([hidden])');
    }

    if (count) count.textContent = `${visible} of ${total} projects`;
    empty?.toggleAttribute('hidden', visible > 0);
    writeUrl();
  }

  function bind(): void {
    search?.addEventListener('input', applyFilters);
    for (const el of [categoryEl, commercialEl, languageEl, contribEl]) {
      el?.addEventListener('change', applyFilters);
    }
    resetEl?.addEventListener('click', () => {
      if (search) search.value = '';
      for (const el of [categoryEl, commercialEl, languageEl, contribEl]) {
        if (el) el.value = '';
      }
      applyFilters();
    });
  }

  async function init(): Promise<void> {
    collectRows();
    if (rows.length) {
      fillSelect(
        categoryEl,
        'category',
        [...new Set(rows.map((r) => r.category))].filter(Boolean).sort(),
      );
      fillSelect(
        languageEl,
        'language',
        [...new Set(rows.flatMap((r) => r.languages))]
          .filter(Boolean)
          .sort((a, b) => a.localeCompare(b)),
      );
      readUrl();
      applyFilters();
      bind();
      loading?.setAttribute('hidden', '');
      app?.removeAttribute('hidden');
    }

    // Refresh from the live feed in the background; the prerendered catalogue
    // stays usable if this fails.
    const feed = await loadAwesomeFeed();
    loading?.setAttribute('hidden', '');
    if (!feed || !app || !grid || !count) {
      if (!rows.length) maintenance?.removeAttribute('hidden');
      return;
    }

    const entries: AwesomeEntry[] = sortEntries(feed.entries);
    grid.innerHTML = projectGroupsHtml(feed.categories, entries);
    collectRows();
    fillSelect(
      categoryEl,
      'category',
      feed.categories.length ? feed.categories : [...new Set(entries.map((e) => e.category))],
    );
    fillSelect(
      languageEl,
      'language',
      uniqueValues(entries, (e) => e.language ?? []),
    );
    readUrl();
    applyFilters();
    app.removeAttribute('hidden');
  }

  void init();
</script>
