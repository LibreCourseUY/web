---
// Components
import Anchor from '@/components/Anchor/Anchor.astro';
import Text from '@/components/Text/Text.astro';
// Layout
import Layout from '@/layouts/Layout.astro';
// Utils
import { formatLink } from '@/lib/utils';
import { communityLinks } from '@/data/community';

const deepwiki = 'https://deepwiki.com';
const discord = communityLinks.discord;

const scope = [
  {
    title: 'Learn in community!',
    description: `Join our <a href="${discord}" target="_blank" class="underline text-emphasis-secondary">Discord</a>, where you will find a community to learn open source together`,
  },
  {
    title: 'Programming Languages',
    description: 'Python, JavaScript, Rust, Go, C, Java, and more',
  },
  {
    title: 'Frameworks',
    description: 'React, Vue, FastAPI, Django, Express, Spring, and more',
  },
  {
    title: 'Tools & Technologies',
    description: 'Git, Docker, PostgreSQL, MongoDB, AWS, Linux, and more',
  },
];

const recommendations = [
  {
    title: 'Web Development',
    items: [
      {
        name: 'JavaScript + React',
        badge: 'Popular',
        description: 'Most popular, huge community, infinite resources',
      },
      {
        name: 'Python + FastAPI',
        badge: 'Easy',
        description: 'Great for APIs, easy syntax, very readable',
      },
    ],
  },
  {
    title: 'Systems & Low-Level',
    items: [
      {
        name: 'Rust',
        badge: 'Modern',
        description: 'Modern, safe, great for learning systems programming',
      },
      {
        name: 'C',
        badge: 'Foundation',
        description: 'Foundation of everything, understand how computers work',
      },
    ],
  },
  {
    title: 'Mobile Development',
    items: [
      {
        name: 'React Native',
        badge: 'Cross-platform',
        description: 'Use JavaScript for iOS and Android',
      },
      {
        name: 'Flutter (Dart)',
        badge: 'Beautiful',
        description: "Google's framework, beautiful UIs",
      },
    ],
  },
  {
    title: 'Data & AI',
    items: [
      {
        name: 'Python',
        badge: 'Top',
        description: 'The language for AI/ML, easiest for data science',
      },
      {
        name: 'Julia',
        badge: 'Growing',
        description: 'Growing fast in scientific computing',
      },
    ],
  },
  {
    title: 'Automation & Scripting',
    items: [
      {
        name: 'Python',
        badge: 'Versatile',
        description: 'Scripts, automation, dev tools, APIs, everything',
      },
      {
        name: 'JavaScript',
        badge: 'Browser',
        description: 'Browser automation, Node.js scripts, web scrapers',
      },
      {
        name: 'Bash',
        badge: 'System',
        description: 'Shell scripting, Linux automation, CLI tools',
      },
      {
        name: 'Go',
        badge: 'Fast',
        description: 'High-performance scripts, CLI tools, automation',
      },
    ],
  },
  {
    title: 'Other Languages',
    items: [
      {
        name: 'Ruby',
        badge: 'Trending',
        description: 'Elegant syntax, great for web development with Rails',
      },
      {
        name: 'TypeScript',
        badge: 'Web',
        description: 'JavaScript with types, great for large web apps',
      },
      {
        name: 'Java',
        badge: 'Enterprise',
        description: 'Industry standard, Android, enterprise backends',
      },
      {
        name: 'C#',
        badge: 'Game',
        description: 'Game development (Unity), Windows apps, .NET',
      },
    ],
  },
];

const phases = [
  {
    number: '01',
    title: 'Quick Context',
    description: `Start with a short introduction to the language or tool. Learn enough to try a small task, then return to tutorials and documentation as new questions come up.`,
    example: `You want to learn Python. Try an introduction to variables, loops, functions and basic data structures, then use them in a small exercise. Keep the resources nearby while you build.`,
  },
  {
    number: '02',
    title: 'Build Something Real',
    description: `Choose a project or a small contribution that interests you. Read its setup guide, try a focused change and use documentation, tutorials and community discussions to understand each step.`,
    example: `You want to contribute to open-groups. Read the README, get the project running and discuss a small task with a maintainer. If you encounter an error, check the relevant documentation and ask the community for guidance.`,
  },
  {
    number: '03',
    title: 'Ask for Help',
    description: `Ask for help when you're unsure how to move forward. Share what you're trying to do, what you've tried and what happened. Discussing the problem is part of learning together.`,
    example: `Your project won't start. Share the command, the error message and the steps you've tried in the LibreCourseUY Discord. You can ask for a hint, a code review or help understanding the next step.`,
  },
];

const learningResources = [
  {
    id: 'courses',
    title: 'Courses & Tutorials',
    description:
      'Build context with a course or a focused explanation, then apply what you learn to a project.',
    items: [
      {
        name: 'freeCodeCamp',
        description: 'Follow a coding curriculum with lessons and projects.',
        href: 'https://www.freecodecamp.org/',
      },
      {
        name: 'Codecademy',
        description: 'Work through interactive programming courses.',
        href: 'https://www.codecademy.com/',
      },
      {
        name: 'Udemy',
        description: 'Find courses on specific programming topics.',
        href: 'https://www.udemy.com/',
      },
      {
        name: 'Coursera',
        description: 'Explore courses from universities and other education providers.',
        href: 'https://www.coursera.org/',
      },
    ],
  },
  {
    id: 'practice',
    title: 'Practice & Exercises',
    description:
      'Try a small challenge to practice a concept or work through a programming problem.',
    items: [
      {
        name: 'Exercism',
        description: 'Practice programming through exercises and mentoring.',
        href: 'https://exercism.org/',
      },
      {
        name: 'LeetCode',
        description: 'Solve programming problems and prepare for technical interviews.',
        href: 'https://leetcode.com/',
      },
    ],
  },
  {
    id: 'community-help',
    title: 'Community Help',
    description:
      "Look for an existing answer or ask a focused question. Share what you're trying to do and what you've already tried.",
    items: [
      {
        name: 'LibreCourseUY Discord',
        description: 'Connect with the community, ask for guidance and share your progress.',
        href: communityLinks.discord,
      },
      {
        name: 'Stack Overflow',
        description:
          'Search programming questions and share a focused question when you need help.',
        href: 'https://stackoverflow.com/',
      },
    ],
  },
];

const startOptions = [
  {
    title: 'First Contribution',
    description: 'Choose a project, find a task and prepare your tools',
    href: '/contribute/',
  },
  {
    title: 'Personal Challenges',
    description: 'Language-agnostic projects to learn coding',
    href: 'https://github.com/LibreCourseUY/initial-Challenges',
  },
  {
    title: 'Ask the Community',
    description: 'Find a starting point and get guidance on Discord',
    href: communityLinks.discord,
  },
];
---

<Layout
  title="Learn Programming by Contributing — LibreCourseUY"
  description="Learn programming through real projects, community support, courses and practice exercises with LibreCourseUY."
>
  <main class="flex min-h-screen flex-col items-start justify-center">
    <section
      class="flex flex-col justify-start items-start w-full min-h-[calc(100dvh-4rem)] pt-12 pb-12"
    >
      <div class="space-y-12 w-full max-w-4xl">
        <div class="space-y-12">
          <Text variant="h1">How to Learn</Text>
          <Text variant="p" className="">
            Our philosophy for learning programming effectively.
          </Text>
          <Anchor
            href="#learning-resources"
            className="inline-flex items-center gap-2 text-base font-bold underline underline-offset-4"
          >
            Browse courses, exercises and community help <span aria-hidden="true">↓</span>
          </Anchor>
        </div>

        <hr class="border-line" />

        <div class="space-y-8">
          <Text variant="h2">The Approach</Text>

          {
            phases.map((phase) => (
              <div class="rounded-lg border border-line p-6 space-y-4">
                <div class="flex flex-row items-center gap-4">
                  <span class="text-xs font-bold text-emphasis-secondary">[{phase.number}]</span>
                  <Text variant="h3" className="font-semibold">
                    {phase.title}
                  </Text>
                </div>
                <Text variant="p">{phase.description}</Text>
                <div class="p-4 border border-line rounded space-y-2">
                  <p class="text-xs font-semibold text-emphasis-secondary">Example:</p>
                  <Text variant="p">{phase.example}</Text>
                </div>
              </div>
            ))
          }
        </div>

        <hr class="border-line" />

        <div class="space-y-8">
          <div class="space-y-4">
            <Text variant="h2">What Can You Learn?</Text>
            <Text variant="p"
              >This approach works for <strong>anything</strong> in programming:</Text
            >
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 ml-4">
            {
              scope.map((item) => (
                <div class="rounded-lg border border-line p-6 space-y-2">
                  <h4 class="text-lg font-bold" set:html={item.title} />
                  <p class="text-sm text-muted" set:html={item.description} />
                </div>
              ))
            }
          </div>
          <div class="p-4 border border-line rounded space-y-2 ml-4">
            <Text variant="p">
              The key is: <strong>context first → build real stuff → ask for help when stuck</strong
              >
            </Text>
          </div>
        </div>

        <hr class="border-line" />

        <div class="space-y-4">
          <Text variant="h2">What is DeepWiki?</Text>
          <Text variant="p">
            <Anchor href={formatLink(deepwiki)}>DeepWiki</Anchor>
            is an AI-powered documentation tool that automatically generates comprehensive documentation
            for your codebase. It creates API references, architecture diagrams, and code explanations.
          </Text>
          <Text variant="p">
            We use DeepWiki across all our projects to help you understand the codebase faster.
            Check the
            <Anchor href="/projects/">Projects</Anchor>
            page for DeepWiki links to each repository.
          </Text>
          <div class="p-4 border border-line rounded space-y-4">
            <Text variant="p">
              <strong class="underline">Why it's useful:</strong> When you're trying to contribute to
              a new project, DeepWiki helps you understand the codebase structure, API endpoints, and
              how different components connect, exactly when you need it.
            </Text>
          </div>
        </div>

        <hr class="border-line" />

        <div class="space-y-4">
          <Text variant="h2">Assisted Autonomy</Text>
          <Text variant="p">
            We believe in <strong>assisted autonomy</strong>: explore a problem, try an approach and
            discuss what you learn. Documentation, examples and community guidance help you
            understand your choices and build skills you can use in the next project.
          </Text>
        </div>

        <hr class="border-line" />

        <div class="space-y-8">
          <div class="space-y-4">
            <Text variant="h2">Recommended for Beginners</Text>
            <Text variant="p">Start with these languages and frameworks based on your goals:</Text>
          </div>

          {
            recommendations.map((section) => (
              <div class="space-y-4">
                <Text variant="h3" className="font-semibold">
                  {section.title}
                </Text>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 ml-4">
                  {section.items.map((item) => (
                    <div class="rounded-lg border border-line p-4 space-y-2">
                      <div class="flex justify-between items-center gap-4">
                        <h4 class="text-lg font-bold">{item.name}</h4>
                        <span class="shrink-0 border border-line px-1.5 py-0.5 text-xs font-medium text-muted">
                          [{item.badge}]
                        </span>
                      </div>
                      <p class="text-sm text-muted">{item.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <hr class="border-line" />

        <section
          id="learning-resources"
          aria-labelledby="learning-resources-heading"
          class="space-y-8"
        >
          <div class="space-y-4">
            <Text variant="h2" id="learning-resources-heading">Learning Resources</Text>
            <Text variant="p">
              Choose a course, practice what you learn and bring your questions to the community.
              For language references, Git guides and developer tools, browse our
              <Anchor href="/docs/" className="text-base text-inherit underline"
                >documentation</Anchor
              >.
            </Text>
          </div>
          {
            learningResources.map((group) => (
              <section id={group.id} aria-labelledby={`${group.id}-heading`} class="space-y-6">
                <div class="space-y-3">
                  <Text variant="h3" id={`${group.id}-heading`} className="font-semibold">
                    {group.title}
                  </Text>
                  <p class="max-w-3xl text-base leading-relaxed text-muted">{group.description}</p>
                </div>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  {group.items.map((item) => (
                    <Anchor
                      href={item.href}
                      className="text-base border border-line bg-surface p-6 text-emphasis/80 transition-colors hover:border-emphasis-secondary/60 hover:text-emphasis"
                    >
                      <div class="flex items-start justify-between gap-4">
                        <h4 class="text-lg font-bold">{item.name}</h4>
                        {item.href.startsWith('https://') && (
                          <span aria-hidden="true" class="shrink-0 text-base">
                            ↗
                          </span>
                        )}
                      </div>
                      <p class="mt-2 text-sm text-muted">{item.description}</p>
                      {item.href.startsWith('https://') && (
                        <span class="sr-only"> (opens in a new tab)</span>
                      )}
                    </Anchor>
                  ))}
                </div>
              </section>
            ))
          }
        </section>

        <div class="space-y-8">
          <div class="space-y-4">
            <Text variant="h2">Ready to Start?</Text>
            <Text variant="p">Pick a language and start building:</Text>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 ml-4">
            {
              startOptions.map((item) => (
                <Anchor
                  href={item.href}
                  className="text-base flex flex-col items-center justify-center gap-2 rounded-lg border border-emphasis/60 p-6 text-center hover:border-emphasis text-emphasis/80 hover:text-emphasis"
                >
                  <h4 class="text-lg font-bold">{item.title}</h4>
                  <p class="text-sm text-muted">{item.description}</p>
                </Anchor>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
