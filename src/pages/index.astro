---
// Libreries
import { Image } from 'astro:assets';
// Components
import Anchor from '@/components/Anchor/Anchor.astro';
import Text from '@/components/Text/Text.astro';
import List from '@/components/List/List.astro';
import ListItem from '@/components/List/ListItem.astro';
import Cards from '@/components/Cards/Cards.astro';
import Collapse from '@/components/Collapse/Collapse.astro';
// Layout
import Layout from '@/layouts/Layout.astro';
// Utils
import { formatLink } from '@/lib/utils';
import type { ProjectType } from '@/lib/types';
// Assets
import heroIcon from '@/assets/hero_icon.png';
import cloudImg from '@/assets/ascii-art-cloud.png';
import computerImg from '@/assets/ascii-art-computer.png';

const aboutList = [
	'<strong class="block">Non-profit</strong> FOSS community based in Uruguay.',
	'<strong class="block">Built for developers at every level </strong>from first commit to seasoned contributor.',
	'Open tools, open curriculum, open processes.',
	'<strong class="block">Growing the next generation </strong>of open source contributors in Latin America.',
];

const importantLinks = {
	discordCommunity: 'https://discord.gg/ZrtwyxcQ',
	github: 'https://github.com/LibreCourseUY',
};

const projects: ProjectType[] = [
	{
		title: 'Inkfing',
		description:
			"simple extension that allows Fing (Facultad de Ingeniería, UdelaR) students to give their day to day web apps a refreshed dark-mode. It's designed to help incoming students find study partners and collaborative projects to work on.",
		autor: {
			name: 'emiliano-gandini',
			link: 'https://github.com/emiliano-gandini-outeda',
		},
		image: null,
		stack: ['HTML', 'CSS', 'JS', 'Manifest V3'],
		pj_link: 'https://github.com/LibreCourseUY/Inkfing',
	},
	{
		title: 'UruAPI',
		description:
			"is a wrapper around datosuruguay.com and exposes Uruguay's daily-updated economic indicators in a clean, JSON-friendly format.",
		autor: {
			name: 'emiliano-gandini',
			link: 'https://github.com/emiliano-gandini-outeda',
		},
		image: null,
		stack: ['Python', 'FastAPI', 'Docker'],
		pj_link: 'https://github.com/LibreCourseUY/UruAPI',
	},
	{
		title: 'KanBan generator',
		description:
			'A highly configurable React component that accepts an array of columns and an array of cards with generic metadata, and supports drag-and-drop interactions between columns.',
		autor: {
			name: 'kevin-ramirez',
			link: 'https://github.com/Kevin-Ramirez127',
		},
		image: null,
		stack: ['React', 'Tailwind', 'Vite', 'Typescript'],
		pj_link: 'https://github.com/LibreCourseUY/kanBan-generator',
	},
];
---

<Layout
	title="LibreCourseUY"
	description="Welcome to LibreCourseUY, a platform for free and open educational resources."
>
	<main class="flex min-h-screen flex-col items-start justify-center">
		<section
			id="hero_section"
			class="relative w-screen left-1/2 -translate-x-1/2 min-h-[80vh] flex items-center justify-center py-16 md:py-24 lg:py-32 overflow-hidden"
		>
			<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-emphasis-secondary/10 via-transparent to-transparent" />
			<Image
				src={cloudImg}
				alt=""
				class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none select-none"
				inferSize={true}
				loading="eager"
			/>
			
			<div class="relative z-10 flex flex-col items-center justify-center w-full px-6 text-center">
				<div class="mb-8 md:mb-10 flex items-center justify-center w-24 sm:w-28 md:w-32 lg:w-40">
					<Image
						src={heroIcon}
						alt="LibreCourseUY Hero Icon"
						class="w-full h-full object-cover"
						inferSize={true}
						loading="eager"
					/>
				</div>
				
				<Text
					variant="h1"
					className="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl max-w-6xl mb-6 text-center"
				>
					Build in public.<br />
					<span class="text-emphasis-secondary">Become open source.</span>
				</Text>
				
				<Text variant="p" className="max-w-2xl mb-10 text-emphasis/70 text-lg text-center md:text-xl">
					A non-profit FOSS community from Uruguay growing the next generation of open source contributors in Latin America.
				</Text>
				
				<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
					<Anchor
						className="px-8 py-3 rounded-lg bg-emphasis-secondary text-background font-semibold hover:bg-emphasis-secondary/90 transition-colors whitespace-nowrap"
						href="/contribute/"
					>
						Start Contributing
					</Anchor>
					<Anchor
						className="px-8 py-3 rounded-lg border border-emphasis/20 text-emphasis font-semibold hover:bg-emphasis/5 hover:border-emphasis/40 transition-colors whitespace-nowrap"
						href="https://github.com/LibreCourseUY"
					>
						View on GitHub
					</Anchor>
				</div>
				
				<div class="flex items-center justify-center gap-8 text-emphasis/50 text-sm font-medium">
					<a href="https://discord.gg/placeholder" class="hover:text-emphasis-secondary transition-colors flex items-center gap-2">
						<svg class="w-5 h-5" xmlns="http://w3.org" viewBox="0 0 127.14 96.36">
							<path fill="#5865F2" d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.79,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.68,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.81,11.1,105.25,105.25,0,0,0,32.22-16.15c2.62-27.28-4.48-51.2-21.16-76.14ZM42.45,65.69C36.18,65.69,31,60,31,53s5.18-12.71,11.45-12.71S53.9,46,53.9,53,48.73,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.23,60,73.23,53s5.18-12.71,11.46-12.71S96.16,46,96.16,53,91,65.69,84.69,65.69Z"/>
						</svg>

						Discord
					</a>
					<span class="hidden sm:inline">·</span>
					<a href="https://github.com/LibreCourseUY" class="hover:text-emphasis-secondary transition-colors flex items-center gap-2">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
						</svg>
						GitHub
					</a>
				</div>
			</div>
			
			<div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
				<svg class="w-6 h-6 text-emphasis/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
				</svg>
			</div>
		</section>
		<section
			id="about"
			class="mb-12 w-full flex flex-row flex-wrap lg:flex-nowrap items-start justify-center gap-x-12"
		>
			<div class="flex flex-col w-full space-y-12 mt-12">
				<Text variant="h2">What is <br /> LibreCourseUY</Text>
				<div class="space-y-12">
					<h3 class="text-4xl">Our mision</h3>
					<List className="w-fit">
						{
							aboutList.map((item, i) => (
								<ListItem className="first:border-t border-b border-neutral-700 p-6 flex flex-row justify-start items-center gap-6">
									<span class="mr-3 text-sm">{String(i + 1).padStart(2, '0')}</span>
									<span set:html={item} />
								</ListItem>
							))
						}
					</List>
				</div>
			</div>
			<Image
				src={computerImg}
				alt="Cloud ASCII art"
				class="aspect-video object-cover mt-12 self-center"
				inferSize={true}
				loading="lazy"
				width={620}
				height={380}
			/>
		</section>
		<section
			id="projects"
			class="min-h-dvh mt-12 overflow"
		>
			<div class="space-y-12">
				<Text variant="h2">Our Projects</Text>
				<Text variant="p"
					>Projects made by students that shows their <br />knowledge in multiple areas</Text
				>
				<div class="space-y-6">
					{
						projects.map((project, i) => (
							<Cards
								{...project}
								index={i}
							/>
						))
					}
				</div>
			</div>
		</section>
		<section id="faq">
			<div class="max-w-200 pt-16 pb-24 space-y-12">
				<Text variant="h1"> Got questions? </Text>
				<div class="[&_.faq-item:last-child]:border-b [&_.faq-item:last-child]:border-white/10">
					<Collapse
						question="What is LibreCourseUY?"
						open
					>
						A non-profit initiative based in Uruguay that helps programmers, from aspiring
						developers to seasoned professionals, contribute to Free and Open Source Software.
					</Collapse>

					<Collapse question="Who can join?">
						Anyone, for free. Members are expected to follow our Code of Conduct, and those who wish
						to contribute must sign the CLA.
					</Collapse>

					<Collapse question="What does LibreCourseUY offer?">
						A strong developer community with common goals, a space to learn and grow your career,
						and real projects worth putting on your CV.
					</Collapse>

					<Collapse question="How do I get started?">
						Read the Code of Conduct, then browse our First Issues list or find a repo you want to
						contribute to. If you're new, check out our Introductory Guide. It covers how to
						collaborate, learn, and get involved.
					</Collapse>

					<Collapse question="Why is everything in English?">
						Open source is a global conversation, and English is its common language. Writing
						issues, PRs, and documentation in English makes your contributions accessible to the
						entire FOSS community, not just Spanish speakers. It also prepares you for real-world
						collaboration on any project, anywhere.
					</Collapse>

					<Collapse question="Where can I find LibreCourseUY?">
						<List>
							<ListItem
								className="first:border-t border-b border-neutral-700 p-6 flex flex-row justify-start items-center gap-6"
							>
								<span class="mr-3 text-sm">{String(1).padStart(2, '0')}</span>
								<span>
									<Text variant="p">
										Contribute on
										<Anchor href={formatLink(importantLinks.github)}>GitHub</Anchor>
									</Text>
								</span>

								<ListItem
									className="first:border-t border-b border-neutral-700 p-6 flex flex-row justify-start items-center gap-6"
								>
									<span class="mr-3 text-sm">{String(1).padStart(2, '0')}</span>
									<Text variant="p"
										>Join on our
										<Anchor href={formatLink(importantLinks.discordCommunity)}>Discord</Anchor>
										server</Text
									>
								</ListItem>
							</ListItem>
						</List>
					</Collapse>
				</div>
			</div>
		</section>
		<footer class="min-h-64 flex flex-row gap-x-12 justify-end items-end pb-12">
			<span class="text-emphasis/60">Libre<span>Course</span>UY</span>
			<span class="footer-copy">© 2026 | Open Source Education</span>
		</footer>
	</main>
</Layout>
