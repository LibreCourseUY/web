---
// Components
import Anchor from '@/components/Anchor/Anchor.astro';
import Text from '@/components/Text/Text.astro';
// Layout
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const targetHrefFromThisPath = (path: string): string => `${currentPath}/${path}`;

const categories = [
  {
    id: 'contributing',
    title: 'Contributing',
    description:
      'Start a contribution, prepare signed commits and understand the project contribution terms.',
    items: [
      {
        name: 'First Contribution',
        description: 'Choose a project, find a task and prepare your first pull request.',
        href: '/new/contribute/',
      },
      {
        name: 'GPG Signature',
        description: 'Set up a GPG key and sign your Git commits.',
        href: targetHrefFromThisPath('gpg-signature'),
      },
      {
        name: 'Developer Certificate of Origin',
        description: 'Understand the DCO and how to add a sign-off to your commits.',
        href: '/new/dco/',
      },
      {
        name: 'GitHub Verification Docs',
        description: 'Look up signing keys and commit signature verification on GitHub.',
        href: 'https://docs.github.com/en/authentication/managing-commit-signature-verification',
      },
    ],
  },
  {
    id: 'git-github',
    title: 'Git & GitHub',
    description:
      'Look up Git commands and GitHub workflows, or practice version control step by step.',
    items: [
      {
        name: 'Git Docs',
        description: 'Find command references and guides for working with Git.',
        href: 'https://git-scm.com/doc',
      },
      {
        name: 'GitHub Docs',
        description: 'Learn how repositories, pull requests and collaboration work on GitHub.',
        href: 'https://docs.github.com/',
      },
      {
        name: 'Pro Git Book',
        description: 'Read a guide to Git, from the basics to more advanced workflows.',
        href: 'https://git-scm.com/book/en/v2',
      },
      {
        name: 'GitHub Skills',
        description: 'Practice GitHub workflows through interactive courses.',
        href: 'https://github.com/skills',
      },
      {
        name: 'Learn Git Branching',
        description: 'Explore branches, merges and rebases with visual exercises.',
        href: 'https://learngitbranching.js.org/',
      },
    ],
  },
  {
    id: 'technical-reference',
    title: 'Technical Reference',
    description: 'Check language syntax, APIs and tool behavior while working on a project.',
    items: [
      {
        name: 'MDN Web Docs',
        description: 'Look up HTML, CSS, JavaScript and web APIs.',
        href: 'https://developer.mozilla.org/',
      },
      {
        name: 'Python Docs',
        description:
          'Find the Python tutorial, language reference and standard library documentation.',
        href: 'https://docs.python.org/3/',
      },
      {
        name: 'Rust Docs',
        description: 'Find the Rust book, language references and standard library documentation.',
        href: 'https://doc.rust-lang.org/stable/',
      },
      {
        name: 'Docker Docs',
        description: 'Look up container concepts, commands and configuration.',
        href: 'https://docs.docker.com/',
      },
      {
        name: 'DevDocs',
        description: 'Search documentation for multiple languages and APIs in one place.',
        href: 'https://devdocs.io/',
      },
      {
        name: 'HackTerms',
        description: 'Look up unfamiliar programming terms.',
        href: 'https://hackterms.com/',
      },
    ],
  },
  {
    id: 'developer-tools',
    title: 'Developer Tools',
    description: 'Test APIs, explore regular expressions, validate JSON and write cron schedules.',
    items: [
      {
        name: 'Postman',
        description: 'Send API requests and inspect responses.',
        href: 'https://www.postman.com/',
      },
      {
        name: 'RegExr',
        description: 'Try regular expressions and explore how they match your text.',
        href: 'https://regexr.com/',
      },
      {
        name: 'JSON Formatter',
        description: 'Format JSON and check its syntax.',
        href: 'https://jsonformatter.org/',
      },
      {
        name: 'Crontab Guru',
        description: 'Write and understand cron schedule expressions.',
        href: 'https://crontab.guru/',
      },
    ],
  },
];
---

<Layout
  noindex
  title="Documentation | LibreCourseUY"
  description="Contribution guides, Git and GitHub resources, technical references and developer tools for the LibreCourseUY community."
>
  <main class="flex min-h-screen flex-col items-start justify-center">
    <section
      class="flex flex-col justify-start items-start w-full min-h-[calc(100dvh-4rem)] pt-12 pb-12"
    >
      <div class="space-y-12 w-full max-w-4xl">
        <header class="space-y-8">
          <div class="space-y-4">
            <Text variant="h1">Documentation</Text>
            <Text variant="p" className="max-w-3xl text-lg leading-relaxed text-muted">
              Find contribution guides, references and tools for your day-to-day development.
            </Text>
            <p class="text-sm leading-relaxed text-muted">
              For courses and practice exercises,
              <Anchor
                href="/new/learn/#learning-resources"
                className="inline-flex items-center gap-1 text-sm font-semibold underline underline-offset-4"
              >
                visit Learn <span aria-hidden="true">→</span>
              </Anchor>.
            </p>
          </div>

          <nav aria-label="Documentation sections" class="border-y border-line py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
              <p class="shrink-0 font-mono text-xs uppercase tracking-wider text-muted">
                On this page
              </p>
              <ul class="flex flex-wrap gap-x-6 gap-y-3">
                {
                  categories.map((category) => (
                    <li>
                      <a
                        href={`#${category.id}`}
                        class="inline-flex items-center gap-2 text-sm font-semibold text-emphasis/80 transition-colors hover:text-emphasis-secondary"
                      >
                        {category.title}
                        <span aria-hidden="true" class="text-muted">
                          ↓
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </nav>
        </header>

        {
          categories.map((category) => (
            <section id={category.id} aria-labelledby={`${category.id}-heading`} class="space-y-6">
              <div class="space-y-3">
                <Text variant="h2" id={`${category.id}-heading`}>
                  {category.title}
                </Text>
                <p class="max-w-3xl text-base leading-relaxed text-muted">{category.description}</p>
              </div>
              <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                {category.items.map((item) => (
                  <Anchor
                    href={item.href}
                    className="rounded-xl border bg-surface text-emphasis/80 hover:text-emphasis border-line hover:border-emphasis-secondary/60 p-6 space-y-2 cursor-pointer transition-colors"
                  >
                    <div class="flex items-start justify-between gap-4">
                      <h3 class="text-lg font-bold">{item.name}</h3>
                      {item.href.startsWith('https://') && (
                        <span aria-hidden="true" class="shrink-0 text-base">
                          ↗
                        </span>
                      )}
                    </div>
                    <p class="text-sm text-muted">{item.description}</p>
                    {item.href.startsWith('https://') && (
                      <span class="sr-only"> (opens in a new tab)</span>
                    )}
                  </Anchor>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
