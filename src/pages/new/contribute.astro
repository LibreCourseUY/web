---
import Anchor from '@/components/Anchor/Anchor.astro';
import List from '@/components/List/List.astro';
import ListItem from '@/components/List/ListItem.astro';
import Text from '@/components/Text/Text.astro';
import Layout from '@/layouts/Layout.astro';
import ContributionSteps from '@/components/ContributionSteps/ContributionSteps.astro';
import { communityLinks } from '@/data/community';
---

<Layout
  noindex
  title="Contribute | LibreCourseUY"
  description="Make your first open source contribution with LibreCourseUY. Choose a project, find a task on Gitsion and prepare your tools with community support."
>
  <main class="flex min-h-screen flex-col items-start justify-center">
    <section
      class="flex flex-col justify-start items-start w-full min-h-[calc(100dvh-4rem)] pt-12 pb-12"
    >
      <div class="space-y-12 w-full max-w-4xl">
        <div class="space-y-12">
          <Text variant="h1">How to Contribute</Text>
          <Text variant="p" className="ml-4">
            Choose a project, find a small task and make your first contribution. Whether you're a
            beginner or an experienced developer, you can learn and build with our community.
          </Text>
          <Anchor
            href={communityLinks.discord}
            className="inline-flex items-center gap-2 border border-emphasis-secondary px-4 py-3 font-mono text-sm font-bold hover:bg-emphasis-secondary hover:text-background"
          >
            Ask for help in Discord <span aria-hidden="true">→</span>
          </Anchor>
        </div>

        <nav
          aria-label="Contribution guide"
          class="flex flex-wrap gap-x-6 gap-y-3 border-y border-line py-4 text-sm font-bold text-emphasis-secondary"
        >
          <a href="#start" class="underline underline-offset-4">Start here</a>
          <a href="#prepare" class="underline underline-offset-4">Prepare your tools</a>
          <a href="#contribution-process" class="underline underline-offset-4"
            >Make a pull request</a
          >
          <a href="#guidelines" class="underline underline-offset-4">Project guidelines</a>
        </nav>

        <div id="start" class="space-y-8">
          <Text variant="h2">Start here</Text>
          <ContributionSteps />
        </div>

        <div id="prepare" class="space-y-6">
          <Text variant="h2">Prepare your contribution</Text>
          <Text variant="p"
            >Once you've chosen a task, use this checklist before making changes.</Text
          >
          <div class="space-y-4 border border-line p-6">
            <Text variant="h3">Read the project's guide</Text>
            <Text variant="p"
              >Check the README, CONTRIBUTING guide and LICENSE file. Each project defines its own
              setup, license and contribution terms. Confirm the scope of your task with the
              maintainer.</Text
            >
          </div>
          <div class="space-y-4 border border-line p-6">
            <Text variant="h3">Set up Git and commit signing</Text>
            <Text variant="p"
              >Our <Anchor href="/new/docs/" className="text-inherit underline"
                >documentation</Anchor
              > includes Git learning resources and a <Anchor
                href="/new/docs/gpg-signature/"
                className="text-inherit underline">GPG signing guide</Anchor
              >. All commits must be signed with GPG and include a <Anchor
                href="/new/dco/"
                className="text-inherit underline">Developer Certificate of Origin (DCO)</Anchor
              > sign-off.</Text
            >
            <Text variant="p"
              >Use <code>git commit -S -s</code> to sign and sign off your commit. If setup is unfamiliar,
              <Anchor href={communityLinks.discord} className="text-inherit underline"
                >ask in Discord</Anchor
              > and share where you're stuck.</Text
            >
          </div>
        </div>

        <hr class="border-line" />

        <div id="contribution-process" class="space-y-4">
          <Text variant="h2">Contribution Process</Text>
          <Text variant="p">Follow these steps to make your first contribution:</Text>

          <div class="space-y-6">
            <div class="space-y-4">
              <List>
                <ListItem
                  className="border-t border-b border-line p-6 flex flex-row-reverse md:flex-row justify-start items-center gap-6"
                >
                  <span class="mr-3 text-sm">{String(1).padStart(2, '0')}</span>
                  <span class="space-y-4 min-w-0">
                    <Text variant="h3" className="font-semibold">Fork the Repository</Text>
                    <Text variant="p"
                      >Click the "Fork" button on the GitHub repository to create your own copy of
                      the project.</Text
                    >
                  </span>
                </ListItem>

                <ListItem
                  className="border-b border-line p-6 flex flex-row-reverse md:flex-row justify-start items-center gap-6"
                >
                  <span class="mr-3 text-sm">{String(2).padStart(2, '0')}</span>
                  <span class="space-y-4 min-w-0">
                    <Text variant="h3" className="font-semibold">Clone Your Fork</Text>
                    <Text variant="p">Download your forked repository to your local machine.</Text>
                    <code class="block p-3 bg-surface border border-line rounded text-sm"
                      >git clone https://github.com/YOUR_USERNAME/project.git</code
                    >
                  </span>
                </ListItem>

                <ListItem
                  className="border-b border-line p-6 flex flex-row-reverse md:flex-row justify-start items-center gap-6"
                >
                  <span class="mr-3 text-sm">{String(3).padStart(2, '0')}</span>
                  <span class="space-y-4 min-w-0">
                    <Text variant="h3" className="font-semibold">Create a Branch</Text>
                    <Text variant="p"
                      >Create a new branch for your changes. Don't work directly on main!</Text
                    >
                    <code class="block p-3 bg-surface border border-line rounded text-sm"
                      >git checkout -b feature/your-feature</code
                    >
                  </span>
                </ListItem>

                <ListItem
                  className="border-b border-line p-6 flex flex-row-reverse md:flex-row justify-start items-center gap-6"
                >
                  <span class="mr-3 text-sm">{String(4).padStart(2, '0')}</span>
                  <span class="space-y-4 min-w-0">
                    <Text variant="h3" className="font-semibold">Make Changes</Text>
                    <Text variant="p"
                      >Edit the code, add features, or fix bugs. Make sure your changes work
                      correctly.</Text
                    >
                  </span>
                </ListItem>

                <ListItem
                  className="border-b border-line p-6 flex flex-row-reverse md:flex-row justify-start items-center gap-6"
                >
                  <span class="mr-3 text-sm">{String(5).padStart(2, '0')}</span>
                  <span class="space-y-4 min-w-0">
                    <Text variant="h3" className="font-semibold">Commit Your Changes</Text>
                    <Text variant="p">Save your changes with a descriptive commit message.</Text>
                    <code class="block p-3 bg-surface border border-line rounded text-sm"
                      >git add . && git commit -S -s -m "feat: description of changes"</code
                    >
                  </span>
                </ListItem>

                <ListItem
                  className="border-b border-line p-6 flex flex-row-reverse md:flex-row justify-start items-center gap-6"
                >
                  <span class="mr-3 text-sm">{String(6).padStart(2, '0')}</span>
                  <span class="space-y-4 min-w-0">
                    <Text variant="h3" className="font-semibold">Push to GitHub</Text>
                    <Text variant="p">Upload your changes to your forked repository.</Text>
                    <code class="block p-3 bg-surface border border-line rounded text-sm"
                      >git push origin feature/your-feature</code
                    >
                  </span>
                </ListItem>

                <ListItem
                  className="p-6 flex flex-row-reverse md:flex-row justify-start items-center gap-6"
                >
                  <span class="mr-3 text-sm">{String(7).padStart(2, '0')}</span>
                  <span class="space-y-4 min-w-0">
                    <Text variant="h3" className="font-semibold">Create Pull Request</Text>
                    <Text variant="p"
                      >Go to the original repository and create a Pull Request. Describe your
                      changes and submit!</Text
                    >
                  </span>
                </ListItem>
              </List>
            </div>
          </div>
        </div>

        <hr class="border-line" />

        <div id="guidelines" class="space-y-12">
          <Text variant="h2">Contribution Guidelines</Text>

          <div class="space-y-8 ml-4">
            <Text variant="h3">Code Standards</Text>
            <List className="list-disc pl-6 space-y-4">
              <ListItem><Text variant="p">Write clean, readable code</Text></ListItem>
              <ListItem><Text variant="p">Add comments for complex logic</Text></ListItem>
              <ListItem><Text variant="p">Follow existing code style conventions</Text></ListItem>
              <ListItem><Text variant="p">Test your changes before submitting</Text></ListItem>
            </List>
          </div>

          <div class="space-y-4">
            <Text variant="h3">Any Language is Welcome</Text>
            <div class="space-y-6 ml-4">
              <Text variant="p">
                You don't have to use the same languages already in the project! Want to add a Rust
                API to open-groups (built with FastAPI)? Go ahead! Want to create a Python CLI tool
                for urumap (built with Vue)? Be our guest!
              </Text>
              <Text variant="p">
                We believe in <strong>polyglot development</strong>. If your language or framework
                is better suited for the job, use it. We'll figure out how to integrate it.
              </Text>
              <div class="p-4 border border-line rounded space-y-4">
                <Text variant="p">
                  <strong>Example:</strong> open-groups is built with FastAPI (Python) + Vue.js, but if
                  you want to add a Rust microservice for image processing or a Go CLI tool for data export,
                  that's exactly what we want to see!
                </Text>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <Text variant="h3">Commit Messages</Text>
            <div class="ml-4">
              <Text variant="p">We use Conventional Commits format:</Text>
              <code class="block p-3 bg-surface border border-line rounded text-sm"
                >type: description</code
              >
              <List className="list-disc pl-6">
                <ListItem><Text variant="p"><code>feat:</code> New feature</Text></ListItem>
                <ListItem><Text variant="p"><code>fix:</code> Bug fix</Text></ListItem>
                <ListItem><Text variant="p"><code>docs:</code> Documentation</Text></ListItem>
                <ListItem
                  ><Text variant="p"><code>refactor:</code> Code restructuring</Text></ListItem
                >
              </List>
            </div>
          </div>

          <div class="space-y-4">
            <Text variant="h3"
              >Signed Commits <strong class="underline font-medium">(Required)</strong></Text
            >
            <Text variant="p">
              All commits must be signed. This is a <strong class="underline"
                >mandatory requirement</strong
              > for contributing.
            </Text>
            <div class="space-y-4">
              <Text variant="h4">Why Signed Commits?</Text>
              <List className="list-disc pl-6 ml-4">
                <ListItem
                  ><Text variant="p"
                    ><strong>Security</strong>: Verifies that you are who you claim to be</Text
                  ></ListItem
                >
                <ListItem
                  ><Text variant="p"
                    ><strong>Integrity</strong>: Guarantees the commit wasn't modified after
                    creation</Text
                  ></ListItem
                >
                <ListItem
                  ><Text variant="p"
                    ><strong>Trust</strong>: Other contributors know changes genuinely come from you</Text
                  ></ListItem
                >
                <ListItem
                  ><Text variant="p"
                    ><strong>Professionalism</strong>: Industry best practice for open source
                    projects</Text
                  ></ListItem
                >
              </List>
            </div>
            <Text variant="p">
              Set up your GPG key following our
              <Anchor href="/new/docs/gpg-signature/">GPG Signature guide</Anchor>.
            </Text>
            <code class="block p-3 bg-surface border border-line rounded text-sm ml-4"
              >git config --global commit.gpgsign true</code
            >
          </div>

          <div class="space-y-4">
            <Text variant="h3">Pull Request Requirements</Text>
            <List className="list-disc pl-6 ml-4">
              <ListItem><Text variant="p">Describe what you changed and why</Text></ListItem>
              <ListItem><Text variant="p">Include screenshots for UI changes</Text></ListItem>
              <ListItem><Text variant="p">Test that everything works</Text></ListItem>
              <ListItem><Text variant="p">Be responsive to feedback</Text></ListItem>
            </List>
          </div>
        </div>

        <hr class="border-line" />

        <div class="space-y-6">
          <Text variant="h2">Have Questions?</Text>
          <div class="ml-4 space-y-4">
            <Text variant="p">We're here to help! You can:</Text>
            <div class="flex flex-col flex-wrap gap-4">
              <Text variant="p">
                Browse tasks on
                <Anchor href={communityLinks.issues}>Gitsion</Anchor>
                and ask project-specific questions in the linked GitHub issue.
              </Text>
              <Text variant="p">
                Find us on our
                <Anchor href={communityLinks.discord}>Discord server</Anchor>
              </Text>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
