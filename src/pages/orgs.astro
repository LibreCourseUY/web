---
import Layout from '@/layouts/Layout.astro';
import Text from '@/components/Text/Text.astro';
import Anchor from '@/components/Anchor/Anchor.astro';
import { communityLinks } from '@/data/community';
import { fetchCatalogueForBuild } from '@/lib/catalogue-build';
import { orgsGridHtml } from '@/lib/catalogue-render';

// Prerender the organisations so the page has content without JS.
const feed = await fetchCatalogueForBuild();
const orgs = feed?.orgs ?? [];
const orgsHtml = orgs.length ? orgsGridHtml(orgs, 'en') : '';
---

<Layout
  title="Open Source Organizations — LibreCourseUY"
  description="Organizations maintaining and governing projects in the LibreCourseUY ecosystem: who they are, what they maintain, and where their source lives."
>
  <main class="flex min-h-screen flex-col items-start justify-center">
    <section class="flex w-full flex-col justify-start items-start gap-8 pt-12 pb-12">
      <div class="space-y-4">
        <Text variant="h1">Orgs</Text>
        <Text variant="p" class="text-muted max-w-3xl">
          Open source orgs from the LCUY ecosystem. Organizations that take responsibility for
          maintaining and governing their projects.
        </Text>
      </div>

      <div class="max-w-3xl space-y-4">
        <Text variant="h2">What an organisation means here</Text>
        <Text variant="p" class="text-muted">
          An organisation is any group that takes responsibility for maintaining and governing one
          or more projects in the ecosystem — a GitHub organisation, a company releasing open
          source, or a collective of maintainers. Organisations marked
          <strong class="text-emphasis">official</strong> belong to LibreCourseUY itself; the rest are
          independent and set their own rules, licences and roadmaps.
        </Text>
        <Text variant="p" class="text-muted">
          Being listed is not an endorsement and it does not transfer ownership. If you maintain
          projects and want them discoverable, open a pull request against the
          <Anchor href="/projects/" className="text-base underline underline-offset-4"
            >project catalogue</Anchor
          > with the organisation name, URL and a short description. Each organisation keeps its own contribution
          rules, so read the repository's <code>CONTRIBUTING.md</code> before sending a change.
        </Text>
        <Text variant="p" class="text-muted">
          Organisations appear here once they have at least one project in the catalogue. If a
          project moves to a different owner, or an organisation stops maintaining it, the entry is
          updated or removed rather than left to drift — a stale directory is worse than a short
          one. Found something out of date? Mention it in
          <Anchor href={communityLinks.discord} className="text-base underline underline-offset-4"
            >Discord</Anchor
          > or send the fix as a pull request.
        </Text>
      </div>

      <div id="orgs-app" class="w-full" hidden={orgs.length === 0}>
        <div
          id="orgs-grid"
          class="grid grid-cols-1 gap-6 pt-4 md:grid-cols-2 lg:grid-cols-3"
          set:html={orgsHtml}
        />
      </div>

      <div id="orgs-maintenance" class="w-full border border-line bg-surface p-8" hidden>
        <Text variant="h3">This section is under maintenance</Text>
        <Text variant="p" class="mt-3 max-w-2xl text-muted">
          The org list is temporarily unavailable. Please check back soon.
        </Text>
      </div>

      <div
        id="orgs-loading"
        class="w-full py-16 text-center text-xs uppercase tracking-wider text-muted"
        hidden={orgs.length > 0}
      >
        Loading orgs...
      </div>
    </section>
  </main>
</Layout>

<script>
  import { loadAwesomeFeed } from '@/lib/awesome-client';
  import { orgsGridHtml } from '@/lib/catalogue-render';

  const app = document.getElementById('orgs-app');
  const grid = document.getElementById('orgs-grid');
  const maintenance = document.getElementById('orgs-maintenance');
  const loading = document.getElementById('orgs-loading');

  async function init() {
    const rendered = (grid?.innerHTML ?? '').trim().length > 0;
    const feed = await loadAwesomeFeed();
    loading?.setAttribute('hidden', '');

    if (!feed || !app || !grid) {
      // Keep the prerendered list if the refresh failed.
      if (!rendered) maintenance?.removeAttribute('hidden');
      return;
    }

    grid.innerHTML = orgsGridHtml(feed.orgs ?? [], 'en');
    app.removeAttribute('hidden');
  }

  void init();
</script>
