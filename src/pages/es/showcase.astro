---
import Layout from '@/layouts/Layout.astro';
import Anchor from '@/components/Anchor/Anchor.astro';
import Text from '@/components/Text/Text.astro';
import ShowcaseCard from '@/components/ShowcaseCard/ShowcaseCard.astro';
import { showcaseContributionUrl, showcaseNoticeFor, showcaseProductsFor } from '@/data/showcase';

const products = showcaseProductsFor('es');
const notice = showcaseNoticeFor('es');
---

<Layout
  title="Lo que hacen nuestros miembros — LibreCourseUY"
  description="Proyectos propios de la gente de LibreCourseUY, adentro y afuera del código abierto. Si tenés uno, lo podés proponer con un pull request."
>
  <main class="flex min-h-screen flex-col items-start">
    <section class="w-full space-y-8 pb-12 pt-12">
      <div class="max-w-3xl space-y-4">
        <Text variant="h1">Lo que hacen nuestros miembros</Text>
        <Text variant="p" className="text-muted">
          Cosas que arma la gente de la comunidad, sean abiertas o no.
        </Text>
        <p class="text-sm leading-relaxed text-muted">{notice}</p>
      </div>
      <nav aria-label="Explorar la comunidad" class="flex flex-wrap gap-x-6 gap-y-4">
        <Anchor href="#submit-product" className="text-sm font-bold underline underline-offset-4">
          Compartí tu producto <span aria-hidden="true">↓</span>
        </Anchor>
        <Anchor href="/es/projects/" className="text-sm font-bold underline underline-offset-4">
          Encontrá proyectos de código abierto para contribuir <span aria-hidden="true">→</span>
        </Anchor>
      </nav>
    </section>

    <section aria-label="Productos de miembros" class="w-full border-t border-line py-12">
      <p class="mb-6 font-mono text-xs uppercase tracking-wider text-muted">
        {products.length} proyectos · A–Z
      </p>
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          products.map((product) => (
            <li class="min-w-0">
              <ShowcaseCard product={product} headingLevel="h2" />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="submit-product" class="w-full space-y-6 border-t border-line py-12 md:py-16">
      <div class="max-w-3xl space-y-4">
        <Text variant="h2">Mostrá lo que estás haciendo</Text>
        <Text variant="p" className="text-muted">
          Si sos parte de LibreCourseUY, mandá tu producto con un pull request. Incluí el nombre, el
          sitio web, una descripción breve y quién lo creó. Los productos de código abierto, de
          código cerrado y comerciales son bienvenidos.
        </Text>
      </div>
      <Anchor
        href={showcaseContributionUrl}
        className="inline-flex items-center gap-2 border border-line px-4 py-3 text-sm font-bold text-emphasis hover:border-emphasis-secondary hover:text-emphasis-secondary"
      >
        Leer la guía de envío <span aria-hidden="true">↗</span>
        <span class="sr-only"> (se abre en una pestaña nueva)</span>
      </Anchor>
    </section>
  </main>
</Layout>
