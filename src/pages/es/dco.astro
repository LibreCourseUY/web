---
// Components
import List from '@/components/List/List.astro';
import ListItem from '@/components/List/ListItem.astro';
import Text from '@/components/Text/Text.astro';
import Footer from '@/components/Footer/Footer.astro';
// Layout
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Certificado de Origen (DCO) — LibreCourseUY"
  description="LibreCourseUY acepta contribuciones bajo el Developer Certificate of Origin (DCO). Cómo certificar cada commit con la línea Signed-off-by."
>
  <main class="flex min-h-screen flex-col items-start justify-center">
    <section
      class="flex flex-col justify-start items-start w-full min-h-[calc(100dvh-4rem)] pt-12 pb-12"
    >
      <Text variant="h1" className="max-w-4xl mb-4">Certificado de Origen para Desarrolladores</Text
      >
      <p class="text-2xl text-emphasis/60 mb-4">DCO</p>

      <div class="space-y-12 w-full max-w-4xl">
        <div class="space-y-4">
          <Text variant="p">
            LibreCourseUY acepta contribuciones bajo el Developer Certificate of Origin (DCO). El
            DCO es una forma liviana de que quien contribuye certifique que tiene el derecho de
            enviar el trabajo bajo la licencia del proyecto.
          </Text>
          <Text variant="p">
            Este documento rige los términos legales bajo los cuales se envían y se aceptan las
            contribuciones. El comportamiento de la comunidad, las normas de colaboración y las
            reglas de identidad también pueden estar regidos por otros documentos del proyecto,
            incluidos <code>CONTRIBUTING.md</code>, <code>CODE_OF_CONDUCT.md</code> y
            <code>TRADEMARK.md</code>.
          </Text>
        </div>

        <hr class="border-line" />

        <div class="space-y-4">
          <Text variant="h2">Cómo firmar tus commits</Text>
          <Text variant="p">
            Certificá cada commit agregando una línea <code>Signed-off-by</code>. La forma más fácil
            es la opción <code>-s</code>, que usa el nombre y el correo configurados en Git:
          </Text>
          <Text variant="p">
            <code>git commit -s -m "feat: describe your change"</code>
          </Text>
          <Text variant="p">
            Esto agrega una línea como
            <code>Signed-off-by: Your Name &lt;you@example.com&gt;</code> al final del mensaje del commit.
            Los commits sin una línea <code>Signed-off-by</code> pueden ser rechazados por el control
            automático de DCO.
          </Text>
        </div>

        <hr class="border-line" />

        <div class="space-y-4">
          <Text variant="h2">Developer Certificate of Origin</Text>
          <Text variant="p">Version 1.1</Text>
          <Text variant="p">
            Copyright (C) 2004, 2006 The Linux Foundation and its contributors. Everyone is
            permitted to copy and distribute verbatim copies of this license document, but changing
            it is not allowed.
          </Text>
        </div>

        <hr class="border-line" />

        <div class="space-y-4">
          <Text variant="h2">Developer's Certificate of Origin 1.1</Text>
          <Text variant="p">By making a contribution to this project, I certify that:</Text>
          <List className="list-disc pl-6">
            <ListItem>
              <Text variant="p">
                (a) The contribution was created in whole or in part by me and I have the right to
                submit it under the open source license indicated in the file; or
              </Text>
            </ListItem>
            <ListItem>
              <Text variant="p">
                (b) The contribution is based upon previous work that, to the best of my knowledge,
                is covered under an appropriate open source license and I have the right under that
                license to submit that work with modifications, whether created in whole or in part
                by me, under the same open source license (unless I am permitted to submit under a
                different license), as indicated in the file; or
              </Text>
            </ListItem>
            <ListItem>
              <Text variant="p">
                (c) The contribution was provided directly to me by some other person who certified
                (a), (b) or (c) and I have not modified it.
              </Text>
            </ListItem>
            <ListItem>
              <Text variant="p">
                (d) I understand and agree that this project and the contribution are public and
                that a record of the contribution (including all personal information I submit with
                it, including my sign-off) is maintained indefinitely and may be redistributed
                consistent with this project or the open source license(s) involved.
              </Text>
            </ListItem>
          </List>
        </div>
      </div>
    </section>
    <Footer />
  </main>
</Layout>
