    title: '¡Aprendé en comunidad!',
    description: `En nuestro <a href="${discord}" target="_blank" class="underline text-emphasis-secondary">Discord</a> hay gente para aprender código abierto juntos`,
  },
  {
    title: 'Lenguajes de programación',
    description: 'Python, JavaScript, Rust, Go, C, Java y más',
  },
  {
    title: 'Frameworks',
    description: 'React, Vue, FastAPI, Django, Express, Spring y más',
  },
  {
    title: 'Herramientas y tecnologías',
    description: 'Git, Docker, PostgreSQL, MongoDB, AWS, Linux y más',
  },
];

const recommendations = [
  {
    title: 'Desarrollo web',
    items: [
      {
        name: 'JavaScript + React',
        badge: 'Popular',
        description: 'El más popular, comunidad enorme, recursos infinitos',
      },
      {
        name: 'Python + FastAPI',
        badge: 'Fácil',
        description: 'Ideal para APIs, sintaxis simple, muy legible',
      },
    ],
  },
  {
    title: 'Sistemas y bajo nivel',
    items: [
      {
        name: 'Rust',
        badge: 'Moderno',
        description: 'Moderno, seguro, ideal para aprender programación de sistemas',
      },
      {
        name: 'C',
        badge: 'Base',
        description: 'La base de todo, entendé cómo funcionan las computadoras',
      },
    ],
  },
  {
    title: 'Desarrollo móvil',
    items: [
      {
        name: 'React Native',
        badge: 'Multiplataforma',
        description: 'Usá JavaScript para iOS y Android',
      },
      {
        name: 'Flutter (Dart)',
        badge: 'Hermoso',
        description: 'El framework de Google, interfaces hermosas',
      },
    ],
  },
  {
    title: 'Datos e IA',
    items: [
      {
        name: 'Python',
        badge: 'Top',
        description: 'El lenguaje de la IA y el ML, el más simple para ciencia de datos',
      },
      {
        name: 'Julia',
        badge: 'En crecimiento',
        description: 'Crece rápido en computación científica',
      },
    ],
  },
  {
    title: 'Automatización y scripting',
    items: [
      {
        name: 'Python',
        badge: 'Versátil',
        description: 'Scripts, automatización, herramientas de desarrollo, APIs, todo',
      },
      {
        name: 'JavaScript',
        badge: 'Navegador',
        description: 'Automatización del navegador, scripts de Node.js, scrapers web',
      },
      {
        name: 'Bash',
        badge: 'Sistema',
        description: 'Scripts de shell, automatización en Linux, herramientas de CLI',
      },
      {
        name: 'Go',
        badge: 'Rápido',
        description: 'Scripts de alto rendimiento, herramientas de CLI, automatización',
      },
    ],
  },
  {
    title: 'Otros lenguajes',
    items: [
      {
        name: 'Ruby',
        badge: 'En tendencia',
        description: 'Sintaxis elegante, ideal para desarrollo web con Rails',
      },
      {
        name: 'TypeScript',
        badge: 'Web',
        description: 'JavaScript con tipos, ideal para aplicaciones web grandes',
      },
      {
        name: 'Java',
        badge: 'Empresarial',
        description: 'Estándar de la industria, Android, backends empresariales',
      },
      {
        name: 'C#',
        badge: 'Juegos',
        description: 'Desarrollo de videojuegos (Unity), apps de Windows, .NET',
      },
    ],
  },
];

const phases = [
  {
    number: '01',
    title: 'Contexto rápido',
    description: `Empezá con una introducción corta al lenguaje o la herramienta. Con lo justo para resolver una tarea chica alcanza; a los tutoriales volvés cuando te aparezcan dudas.`,
    example: `Querés aprender Python. Probá una introducción a variables, bucles, funciones y estructuras de datos básicas, y después usalas en un ejercicio corto. Tené los recursos a mano mientras construís.`,
  },
  {
    number: '02',
    title: 'Construí algo real',
    description: `Elegí un proyecto o una contribución chica que te interese. Leé la guía de instalación, intentá un cambio acotado y usá los tutoriales, la documentación y lo que se charla en la comunidad para entender cada paso.`,
    example: `Querés contribuir a open-groups. Leé el README, hacé funcionar el proyecto y hablá con un mantenedor sobre una tarea chica. Si te aparece un error, revisá la documentación correspondiente y pedí orientación en la comunidad.`,
  },
  {
    number: '03',
    title: 'Pedí ayuda',
    description: `Pedí ayuda cuando no tengas claro cómo seguir. Contá qué estás intentando, qué probaste y qué pasó. Pensar el problema en voz alta también es aprender.`,
    example: `Tu proyecto no arranca. Compartí el comando, el mensaje de error y los pasos que probaste en el Discord de LibreCourseUY. Podés pedir una pista, una revisión de código o ayuda para entender el próximo paso.`,
  },
];

const learningResources = [
  {
    id: 'courses',
    title: 'Cursos y tutoriales',
    description:
      'Armá contexto con un curso o una explicación concreta y después aplicá lo que aprendiste en un proyecto.',
    items: [
      {
        name: 'freeCodeCamp',
        description: 'Seguí un plan de estudios de programación con lecciones y proyectos.',
        href: 'https://www.freecodecamp.org/',
      },
      {
        name: 'Codecademy',
        description: 'Hacé cursos interactivos de programación.',
        href: 'https://www.codecademy.com/',
      },
      {
        name: 'Udemy',
        description: 'Encontrá cursos sobre temas específicos de programación.',
        href: 'https://www.udemy.com/',
      },
      {
        name: 'Coursera',
        description: 'Explorá cursos de universidades y otras instituciones educativas.',
        href: 'https://www.coursera.org/',
      },
    ],
  },
  {
    id: 'practice',
    title: 'Práctica y ejercicios',
    description:
      'Probá un desafío corto para practicar un concepto o resolver un problema de programación.',
    items: [
      {
        name: 'Exercism',
        description: 'Practicá programación con ejercicios y mentoría.',
        href: 'https://exercism.org/',
      },
      {
        name: 'LeetCode',
        description: 'Resolvé problemas de programación y preparate para entrevistas técnicas.',
        href: 'https://leetcode.com/',
      },
    ],
  },
  {
    id: 'community-help',
    title: 'Ayuda de la comunidad',
    description:
      'Buscá una respuesta existente o hacé una pregunta concreta. Contá qué estás intentando hacer y qué probaste ya.',
    items: [
      {
        name: 'LibreCourseUY Discord',
        description: 'Conectate con la comunidad, pedí orientación y compartí tus avances.',
        href: communityLinks.discord,
      },
      {
        name: 'Stack Overflow',
        description:
          'Buscá preguntas de programación y hacé una pregunta concreta cuando necesites ayuda.',
        href: 'https://stackoverflow.com/',
      },
    ],
  },
];

const startOptions = [
  {
    title: 'Primera contribución',
    description: 'Elegí un proyecto, encontrá una tarea y prepará tus herramientas',
    href: '/es/contribute/',
  },
  {
    title: 'Desafíos personales',
    description: 'Proyectos agnósticos del lenguaje para aprender a programar',
    href: 'https://github.com/LibreCourseUY/initial-Challenges',
  },
  {
    title: 'Preguntá a la comunidad',
    description: 'Encontrá un punto de partida y recibí orientación en Discord',
    href: communityLinks.discord,
  },
];
---

<Layout
  title="Aprendé a programar contribuyendo — LibreCourseUY"
  description="Aprendé a programar de verdad con proyectos reales, el apoyo de la comunidad, cursos y ejercicios de práctica de LibreCourseUY."
>
  <main class="flex min-h-screen flex-col items-start justify-center">
    <section
      class="flex flex-col justify-start items-start w-full min-h-[calc(100dvh-4rem)] pt-12 pb-12"
    >
      <div class="space-y-12 w-full max-w-4xl">
        <div class="space-y-12">
          <Text variant="h1">Cómo aprender</Text>
          <Text variant="p" className=""> Así aprendemos a programar acá. </Text>
          <Anchor
            href="#learning-resources"
            className="inline-flex items-center gap-2 text-base font-bold underline underline-offset-4"
          >
            Mirá cursos, ejercicios y ayuda de la comunidad <span aria-hidden="true">↓</span>
          </Anchor>
        </div>

        <hr class="border-line" />

        <div class="space-y-8">
          <Text variant="h2">El enfoque</Text>

          {
            phases.map((phase) => (
              <div class="rounded-lg border border-line p-6 space-y-4">
                <div class="flex flex-row items-center gap-4">
                  <span class="text-xs font-bold text-emphasis-secondary">[{phase.number}]</span>
                  <Text variant="h3" className="font-semibold">
                    {phase.title}
                  </Text>
                </div>
                <Text variant="p">{phase.description}</Text>
                <div class="p-4 border border-line rounded space-y-2">
                  <p class="text-xs font-semibold text-emphasis-secondary">Ejemplo:</p>
                  <Text variant="p">{phase.example}</Text>
                </div>
              </div>
            ))
          }
        </div>

        <hr class="border-line" />

        <div class="space-y-8">
          <div class="space-y-4">
            <Text variant="h2">¿Qué podés aprender?</Text>
            <Text variant="p"
              >Este enfoque funciona para <strong>cualquier cosa</strong> de la programación:</Text
            >
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 ml-4">
            {
              scope.map((item) => (
                <div class="rounded-lg border border-line p-6 space-y-2">
                  <h4 class="text-lg font-bold" set:html={item.title} />
                  <p class="text-sm text-muted" set:html={item.description} />
                </div>
              ))
            }
          </div>
          <div class="p-4 border border-line rounded space-y-2 ml-4">
            <Text variant="p">
              La clave es: <strong
                >primero el contexto → construí cosas reales → pedí ayuda cuando te trabás</strong
              >
            </Text>
          </div>
        </div>

        <hr class="border-line" />

        <div class="space-y-4">
          <Text variant="h2">¿Qué es DeepWiki?</Text>
          <Text variant="p">
            <Anchor href={formatLink(deepwiki)}>DeepWiki</Anchor>
            es una herramienta de documentación impulsada por IA que genera automáticamente documentación
            completa de tu base de código. Crea referencias de API, diagramas de arquitectura y explicaciones
            del código.
          </Text>
          <Text variant="p">
            Usamos DeepWiki en todos nuestros proyectos para que entiendas la base de código más
            rápido. Mirá la
            <Anchor href="/es/projects/">página de proyectos</Anchor>
            para encontrar los enlaces de DeepWiki de cada repositorio.
          </Text>
          <div class="p-4 border border-line rounded space-y-4">
            <Text variant="p">
              <strong class="underline">Por qué sirve:</strong> cuando estás tratando de contribuir a
              un proyecto nuevo, DeepWiki te ayuda a entender la estructura de la base de código, los
              endpoints de la API y cómo se conectan los distintos componentes, justo cuando lo necesitás.
            </Text>
          </div>
        </div>

        <hr class="border-line" />

        <div class="space-y-4">
          <Text variant="h2">Autonomía asistida</Text>
          <Text variant="p">
            Creemos en la <strong>autonomía asistida</strong>: explorá un problema, probá un enfoque
            y comentá lo que aprendiste. La documentación, los ejemplos y la orientación de la
            comunidad te ayudan a entender tus decisiones y a construir habilidades que vas a poder
            usar en el próximo proyecto.
          </Text>
        </div>

        <hr class="border-line" />

        <div class="space-y-8">
          <div class="space-y-4">
            <Text variant="h2">Recomendado para empezar</Text>
            <Text variant="p">Empezá con estos lenguajes y frameworks según tus objetivos:</Text>
          </div>

          {
            recommendations.map((section) => (
              <div class="space-y-4">
                <Text variant="h3" className="font-semibold">
                  {section.title}
                </Text>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 ml-4">
                  {section.items.map((item) => (
                    <div class="rounded-lg border border-line p-4 space-y-2">
                      <div class="flex justify-between items-center gap-4">
                        <h4 class="text-lg font-bold">{item.name}</h4>
                        <span class="shrink-0 border border-line px-1.5 py-0.5 text-xs font-medium text-muted">
                          [{item.badge}]
                        </span>
                      </div>
                      <p class="text-sm text-muted">{item.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <hr class="border-line" />

        <section
          id="learning-resources"
          aria-labelledby="learning-resources-heading"
          class="space-y-8"
        >
          <div class="space-y-4">
            <Text variant="h2" id="learning-resources-heading">Recursos de aprendizaje</Text>
            <Text variant="p">
              Elegí un curso, practicá lo que aprendés y llevá tus dudas a la comunidad. Para
              referencias de lenguajes, guías de Git y herramientas de desarrollo, mirá nuestra
              <Anchor href="/es/docs/" className="text-base text-inherit underline"
                >documentación</Anchor
              >.
            </Text>
          </div>
          {
            learningResources.map((group) => (
              <section id={group.id} aria-labelledby={`${group.id}-heading`} class="space-y-6">
                <div class="space-y-3">
                  <Text variant="h3" id={`${group.id}-heading`} className="font-semibold">
                    {group.title}
                  </Text>
                  <p class="max-w-3xl text-base leading-relaxed text-muted">{group.description}</p>
                </div>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                  {group.items.map((item) => (
                    <Anchor
                      href={item.href}
                      className="text-base border border-line bg-surface p-6 text-emphasis/80 transition-colors hover:border-emphasis-secondary/60 hover:text-emphasis"
                    >
                      <div class="flex items-start justify-between gap-4">
                        <h4 class="text-lg font-bold">{item.name}</h4>
                        {item.href.startsWith('https://') && (
                          <span aria-hidden="true" class="shrink-0 text-base">
                            ↗
                          </span>
                        )}
                      </div>
                      <p class="mt-2 text-sm text-muted">{item.description}</p>
                      {item.href.startsWith('https://') && (
                        <span class="sr-only"> (abre en una pestaña nueva)</span>
                      )}
                    </Anchor>
                  ))}
                </div>
              </section>
            ))
          }
        </section>

        <div class="space-y-8">
          <div class="space-y-4">
            <Text variant="h2">¿Listo para empezar?</Text>
            <Text variant="p">Elegí un lenguaje y empezá a construir:</Text>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 ml-4">
            {
              startOptions.map((item) => (
                <Anchor
                  href={item.href}
                  className="text-base flex flex-col items-center justify-center gap-2 rounded-lg border border-emphasis/60 p-6 text-center hover:border-emphasis text-emphasis/80 hover:text-emphasis"
                >
                  <h4 class="text-lg font-bold">{item.title}</h4>
                  <p class="text-sm text-muted">{item.description}</p>
                </Anchor>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
