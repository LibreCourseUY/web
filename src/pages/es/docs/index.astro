---
// Components
import Anchor from '@/components/Anchor/Anchor.astro';
import Text from '@/components/Text/Text.astro';
// Layout
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const targetHrefFromThisPath = (path: string): string => `${currentPath}/${path}`;

const categories = [
  {
    id: 'contributing',
    title: 'Contribuir',
    description:
      'Empezá una contribución, prepará commits firmados y conocé los términos de contribución del proyecto.',
    items: [
      {
        name: 'Primera contribución',
        description: 'Elegí un proyecto, encontrá una tarea y prepará tu primer pull request.',
        href: '/es/contribute/',
      },
      {
        name: 'Firma GPG',
        description: 'Configurá una clave GPG y firmá tus commits de Git.',
        href: targetHrefFromThisPath('gpg-signature'),
      },
      {
        name: 'Developer Certificate of Origin',
        description: 'Entendé el DCO y cómo agregar un sign-off a tus commits.',
        href: '/es/dco/',
      },
      {
        name: 'Documentación de verificación de GitHub',
        description:
          'Consultá sobre claves de firma y verificación de firmas de commits en GitHub.',
        href: 'https://docs.github.com/en/authentication/managing-commit-signature-verification',
      },
    ],
  },
  {
    id: 'git-github',
    title: 'Git y GitHub',
    description:
      'Consultá comandos de Git y flujos de trabajo de GitHub, o practicá control de versiones paso a paso.',
    items: [
      {
        name: 'Documentación de Git',
        description: 'Encontrá referencias de comandos y guías para trabajar con Git.',
        href: 'https://git-scm.com/doc',
      },
      {
        name: 'Documentación de GitHub',
        description:
          'Aprendé cómo funcionan los repositorios, los pull requests y la colaboración en GitHub.',
        href: 'https://docs.github.com/',
      },
      {
        name: 'Libro Pro Git',
        description: 'Leé una guía de Git, desde lo básico hasta flujos de trabajo más avanzados.',
        href: 'https://git-scm.com/book/en/v2',
      },
      {
        name: 'GitHub Skills',
        description: 'Practicá flujos de trabajo de GitHub con cursos interactivos.',
        href: 'https://github.com/skills',
      },
      {
        name: 'Learn Git Branching',
        description: 'Explorá ramas, merges y rebases con ejercicios visuales.',
        href: 'https://learngitbranching.js.org/',
      },
    ],
  },
  {
    id: 'technical-reference',
    title: 'Referencia técnica',
    description:
      'Consultá sintaxis de lenguajes, APIs y el comportamiento de las herramientas mientras trabajás en un proyecto.',
    items: [
      {
        name: 'MDN Web Docs',
        description: 'Consultá HTML, CSS, JavaScript y APIs web.',
        href: 'https://developer.mozilla.org/',
      },
      {
        name: 'Documentación de Python',
        description:
          'Encontrá el tutorial de Python, la referencia del lenguaje y la documentación de la biblioteca estándar.',
        href: 'https://docs.python.org/3/',
      },
      {
        name: 'Documentación de Rust',
        description:
          'Encontrá el libro de Rust, las referencias del lenguaje y la documentación de la biblioteca estándar.',
        href: 'https://doc.rust-lang.org/stable/',
      },
      {
        name: 'Documentación de Docker',
        description: 'Consultá conceptos de contenedores, comandos y configuración.',
        href: 'https://docs.docker.com/',
      },
      {
        name: 'DevDocs',
        description: 'Buscá documentación de varios lenguajes y APIs en un solo lugar.',
        href: 'https://devdocs.io/',
      },
      {
        name: 'HackTerms',
        description: 'Consultá términos de programación que no conozcas.',
        href: 'https://hackterms.com/',
      },
    ],
  },
  {
    id: 'developer-tools',
    title: 'Herramientas de desarrollo',
    description:
      'Probá APIs, explorá expresiones regulares, validá JSON y escribí expresiones de cron.',
    items: [
      {
        name: 'Postman',
        description: 'Enviá solicitudes a APIs e inspeccioná las respuestas.',
        href: 'https://www.postman.com/',
      },
      {
        name: 'RegExr',
        description: 'Probá expresiones regulares y mirá cómo coinciden con tu texto.',
        href: 'https://regexr.com/',
      },
      {
        name: 'JSON Formatter',
        description: 'Formateá JSON y verificá su sintaxis.',
        href: 'https://jsonformatter.org/',
      },
      {
        name: 'Crontab Guru',
        description: 'Escribí y entendé expresiones de programación de cron.',
        href: 'https://crontab.guru/',
      },
    ],
  },
];
---

<Layout
  title="Documentación para contribuir: Git, GPG y GitHub"
  description="Guías de contribución, recursos de Git y GitHub, referencias técnicas y herramientas para la comunidad de LibreCourseUY."
>
  <main class="flex min-h-screen flex-col items-start justify-center">
    <section
      class="flex flex-col justify-start items-start w-full min-h-[calc(100dvh-4rem)] pt-12 pb-12"
    >
      <div class="space-y-12 w-full max-w-4xl">
        <header class="space-y-8">
          <div class="space-y-4">
            <Text variant="h1">Documentación</Text>
            <Text variant="p" className="max-w-3xl text-lg leading-relaxed text-muted">
              Encontrá guías de contribución, referencias y herramientas para tu desarrollo de todos
              los días.
            </Text>
            <p class="text-sm leading-relaxed text-muted">
              Para cursos y ejercicios de práctica,
              <Anchor
                href="/es/learn/#learning-resources"
                className="inline-flex items-center gap-1 text-sm font-semibold underline underline-offset-4"
              >
                visitá la guía de aprendizaje <span aria-hidden="true">→</span>
              </Anchor>.
            </p>
          </div>

          <nav aria-label="Secciones de la documentación" class="border-y border-line py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
              <p class="shrink-0 font-mono text-xs uppercase tracking-wider text-muted">
                En esta página
              </p>
              <ul class="flex flex-wrap gap-x-6 gap-y-3">
                {
                  categories.map((category) => (
                    <li>
                      <a
                        href={`#${category.id}`}
                        class="inline-flex items-center gap-2 text-sm font-semibold text-emphasis/80 transition-colors hover:text-emphasis-secondary"
                      >
                        {category.title}
                        <span aria-hidden="true" class="text-muted">
                          ↓
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </nav>
        </header>

        {
          categories.map((category) => (
            <section id={category.id} aria-labelledby={`${category.id}-heading`} class="space-y-6">
              <div class="space-y-3">
                <Text variant="h2" id={`${category.id}-heading`}>
                  {category.title}
                </Text>
                <p class="max-w-3xl text-base leading-relaxed text-muted">{category.description}</p>
              </div>
              <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                {category.items.map((item) => (
                  <Anchor
                    href={item.href}
                    className="rounded-xl border bg-surface text-emphasis/80 hover:text-emphasis border-line hover:border-emphasis-secondary/60 p-6 space-y-2 cursor-pointer transition-colors"
                  >
                    <div class="flex items-start justify-between gap-4">
                      <h3 class="text-lg font-bold">{item.name}</h3>
                      {item.href.startsWith('https://') && (
                        <span aria-hidden="true" class="shrink-0 text-base">
                          ↗
                        </span>
                      )}
                    </div>
                    <p class="text-sm text-muted">{item.description}</p>
                    {item.href.startsWith('https://') && (
                      <span class="sr-only"> (se abre en una pestaña nueva)</span>
                    )}
                  </Anchor>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
