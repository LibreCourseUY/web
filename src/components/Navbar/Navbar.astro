---
// Utils
import { cn } from '@/lib/utils';

export interface Props {
  className?: string;
  pathname?: string;
}

const { className, pathname } = Astro.props;

const route = [
  { name: "Home", href: "/" },
  { name: "Learn", href: "/learn" },
  { name: "Projects", href: "/projects" },
  { name: "Docs", href: "/docs" },
  { name: "Open source", href: "/contribute/" },
  { name: "CLA", href: "/cla" },
];
---

<div
  class={cn(
    className,
    "h-16 w-dvw bg-background/95 px-6 md:px-12 lg:px-24 sticky top-0 backdrop-blur-sm z-100 flex items-center justify-center",
  )}
>
  <div
    class={cn("h-16 w-full flex flex-row justify-between items-center")}
  >
    <a href="/" class="flex items-center text-xl">
      LibreCourseUY
    </a>

    <div class="hidden md:flex flex-row items-center gap-4">
      <ul class="flex flex-row gap-4">
        {route.map((item, _, arr) => (
          <li>
            <a
              class={cn(
                "text-sm font-bold inline-block",
                arr.at(-1)?.name === item.name
                  ? "pr-0 border-r-0"
                  : "pr-3 border-r border-neutral-700",
                pathname === item.href || pathname === `${item.href}/`
                  ? "text-emphasis/60 font-normal"
                  : "text-emphasis hover:text-emphasis/80",
              )}
              href={item.href}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
      <button
        id="theme-toggle"
        class="flex items-center justify-center w-8 h-8 rounded-full hover:bg-emphasis/10 transition-colors"
        aria-label="Toggle theme"
      >
        <svg class="hidden dark:block w-5 h-5 text-emphasis" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="block dark:hidden w-5 h-5 text-emphasis" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <button
      id="mobile-menu-toggle"
      class="md:hidden relative flex flex-col justify-center items-center w-8 h-8 z-50 group"
    >
      <span class="absolute w-7 h-0.5 bg-emphasis rounded-full transition-transform duration-300 -translate-y-1 group-[.is-open]:translate-y-0 group-[.is-open]:rotate-45"></span>
      <span class="absolute w-7 h-0.5 bg-emphasis rounded-full transition-transform duration-300 translate-y-1 group-[.is-open]:translate-y-0 group-[.is-open]:-rotate-45"></span>
    </button>
  </div>
</div>

<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-[90] flex flex-col bg-background px-6 pt-24 pb-4 transition-transform duration-500 ease-in-out -translate-y-full"
>
  <div class="flex flex-1 flex-col items-center justify-start gap-8 pt-8 pb-32">
    <ul class="flex flex-col items-center gap-8">
      {route.map((item) => (
        <li>
          <a
            class={cn(
              "text-2xl font-bold tracking-wide transition-colors",
              pathname === item.href
                ? "text-emphasis/60"
                : "text-emphasis hover:text-emphasis/80",
            )}
            href={item.href}
          >
            {item.name}
          </a>
        </li>
      ))}
    </ul>
    <button
      id="theme-toggle-mobile"
      class="bg-emphasis mt-4 px-8 py-3 rounded-full font-bold text-background cursor-pointer transition-transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2"
    >
      <svg class="hidden dark:block w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <svg class="block dark:hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
      Theme
    </button>
  </div>
</div>

<script>
  function getTheme(): string | null {
    return localStorage.getItem('theme');
  }

  function applyTheme(theme: string) {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    document.documentElement.classList.toggle('light', theme === 'light');
    localStorage.setItem('theme', theme);
  }

  function getEffectiveTheme(): string {
    const stored = getTheme();
    if (stored) return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function setupThemeToggle() {
    const stored = getTheme();
    if (stored) applyTheme(stored);

    const handler = () => {
      const next = getEffectiveTheme() === 'dark' ? 'light' : 'dark';
      applyTheme(next);
    };

    document.getElementById('theme-toggle')!.onclick = handler;
    document.getElementById('theme-toggle-mobile')!.onclick = handler;
  }

  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const overlay = document.getElementById('mobile-menu-overlay');

    if (!toggleBtn || !overlay) return;

    let isOpen = false;

    const toggleMenu = () => {
      isOpen = !isOpen;
      if (isOpen) {
        overlay.classList.remove('-translate-y-full');
        overlay.classList.add('translate-y-0');
        toggleBtn.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      } else {
        overlay.classList.add('-translate-y-full');
        overlay.classList.remove('translate-y-0');
        toggleBtn.classList.remove('is-open');
        document.body.style.overflow = '';
      }
    };

    toggleBtn.onclick = toggleMenu;

    overlay.querySelectorAll('a').forEach(link => {
      link.onclick = () => { if (isOpen) toggleMenu(); };
    });
  }

  setupThemeToggle();
  setupMobileMenu();

  document.addEventListener('astro:page-load', () => {
    setupThemeToggle();
    setupMobileMenu();
  });
</script>

<style>
  #mobile-menu-toggle.is-open .line-1 {
    transform: translateY(0) rotate(45deg);
  }
  #mobile-menu-toggle.is-open .line-2 {
    transform: translateY(0) rotate(-45deg);
  }
</style>
