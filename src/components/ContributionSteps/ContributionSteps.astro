---
import Anchor from '@/components/Anchor/Anchor.astro';
import Text from '@/components/Text/Text.astro';
import { communityLinks } from '@/data/community';
import { cn } from '@/lib/utils';
import { langFromPath, localizePath, type Lang } from '@/i18n/config';

const lang: Lang = langFromPath(Astro.url.pathname);
const at = (path: string) => localizePath(path, lang);

const copy = {
  en: {
    ariaLabel: 'Your first contribution',
    steps: [
      {
        title: 'Choose a project',
        description:
          'Find something you care about. Code, documentation, design and testing are all ways to contribute.',
        href: '/projects/',
        link: 'Explore projects',
        external: false,
      },
      {
        title: 'Find a way to help',
        description:
          'Browse open issues on Gitsion. Ask the maintainer about a small task, or bring your questions to Discord.',
        href: communityLinks.issues,
        link: 'Browse open work',
        external: true,
      },
      {
        title: 'Make your first contribution',
        description:
          'Read the project guide, prepare your tools and make one focused change. Ask for feedback as you go.',
        href: '/contribute/#prepare',
        link: 'Prepare your contribution',
        external: false,
      },
    ],
    opensInNewTab: '(opens in a new tab)',
    outroStart: 'New to open source? Look for',
    goodFirstIssues: 'good first issues',
    outroMiddle: '. If none are open, or you are unsure where to start,',
    askInDiscord: 'ask in Discord',
    outroEnd: 'and share what you would like to learn. You can also start with our',
    challenges: 'practice challenges',
  },
  es: {
    ariaLabel: 'Tu primera contribución',
    steps: [
      {
        title: 'Elegí un proyecto',
        description:
          'Buscá algo que te importe. Código, documentación, diseño y pruebas son formas de contribuir.',
        href: '/projects/',
        link: 'Explorar proyectos',
        external: false,
      },
      {
        title: 'Encontrá cómo ayudar',
        description:
          'Mirá los issues abiertos en Gitsion. Preguntale al mantenedor por una tarea chica o traé tus dudas a Discord.',
        href: communityLinks.issues,
        link: 'Ver trabajo disponible',
        external: true,
      },
      {
        title: 'Hacé tu primera contribución',
        description:
          'Leé la guía del proyecto, prepará tus herramientas y hacé un cambio enfocado. Pedí devoluciones mientras avanzás.',
        href: '/contribute/#prepare',
        link: 'Preparar tu contribución',
        external: false,
      },
    ],
    opensInNewTab: '(se abre en una pestaña nueva)',
    outroStart: '¿Recién empezás en código abierto? Buscá',
    goodFirstIssues: 'issues para empezar',
    outroMiddle: '. Si no hay ninguno abierto, o no sabés por dónde arrancar,',
    askInDiscord: 'preguntá en Discord',
    outroEnd: 'y contá qué te gustaría aprender. También podés empezar con nuestros',
    challenges: 'desafíos de práctica',
  },
} as const;

const t = copy[lang];
const steps = [...t.steps] as Array<{
  title: string;
  description: string;
  href: string;
  link: string;
  external: boolean;
}>;

const stepsUrl = (href: string) => (href.startsWith('http') ? href : at(href));
---

<ol class="grid border-y border-line md:grid-cols-3" aria-label={t.ariaLabel}>
  {
    steps.map((step, index) => (
      <li
        class={cn(
          'flex min-w-0 flex-col gap-5 py-8 md:px-6',
          index !== steps.length - 1 && 'border-b border-line md:border-r md:border-b-0',
        )}
      >
        <span class="font-mono text-sm text-emphasis-secondary" aria-hidden="true">
          [{String(index + 1).padStart(2, '0')}]
        </span>
        <Text variant="h3" className="text-xl font-bold">
          {step.title}
        </Text>
        <p class="text-base leading-relaxed text-muted">{step.description}</p>
        <Anchor
          href={stepsUrl(step.href)}
          className="mt-auto w-fit text-sm font-bold underline underline-offset-4"
        >
          {step.link}
          <span aria-hidden="true">{step.external ? ' ↗' : ' →'}</span>
          {step.external && <span class="sr-only"> {t.opensInNewTab}</span>}
        </Anchor>
      </li>
    ))
  }
</ol>

<p class="max-w-3xl text-base leading-relaxed text-muted">
  {t.outroStart}
  <Anchor href={communityLinks.firstIssues} className="text-base underline underline-offset-4">
    {t.goodFirstIssues}<span aria-hidden="true"> ↗</span>
  </Anchor>{t.outroMiddle}
  <Anchor href={communityLinks.discord} className="text-base underline underline-offset-4">
    {t.askInDiscord}
  </Anchor>
  {t.outroEnd}
  <Anchor
    href="https://github.com/LibreCourseUY/initial-Challenges"
    className="text-base underline underline-offset-4"
  >
    {t.challenges}<span aria-hidden="true"> ↗</span>
  </Anchor>.
</p>
