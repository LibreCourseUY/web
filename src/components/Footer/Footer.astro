---
import Anchor from '@/components/Anchor/Anchor.astro';
import { communityLinks } from '@/data/community';

const year = new Date().getFullYear();
const groups = [
  {
    id: 'footer-site',
    title: 'Site',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Projects', href: '/projects/' },
      { label: 'Organizations', href: '/orgs/' },
      { label: 'Docs', href: '/docs/' },
      { label: 'Contribute', href: '/contribute/' },
    ],
  },
  {
    id: 'footer-community',
    title: 'Community',
    links: [
      { label: 'GitHub', href: communityLinks.github },
      { label: 'Discord', href: communityLinks.discord },
      { label: 'Instagram', href: communityLinks.instagram },
      { label: 'r/LibreCourseUY', href: communityLinks.reddit },
      { label: 'r/VibeCodingUY', href: communityLinks.redditVibeCoding },
      { label: 'r/ClaudeCodeUY', href: communityLinks.redditClaudeCode },
      { label: 'IRC', href: communityLinks.irc },
    ],
  },
];
---

<footer class="border-t border-line py-8 md:py-10">
  <div
    class="grid grid-cols-[2fr_3fr] gap-x-4 gap-y-6 md:grid-cols-1 xl:grid-cols-[2fr_3fr] xl:gap-x-10"
  >
    {
      groups.map(({ id, title, links }) => (
        <nav aria-labelledby={id} class="min-w-0">
          <h2 id={id} class="text-base font-bold text-emphasis">
            {title}
          </h2>
          <ul class="mt-2 flex flex-col items-start gap-x-4 gap-y-1 text-sm md:flex-row md:flex-wrap">
            {links.map(({ label, href }) => (
              <li>
                <Anchor
                  href={href}
                  className="flex min-h-7 min-w-7 items-center hover:text-emphasis"
                >
                  {label}
                </Anchor>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div
    class="mt-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-line pt-4"
  >
    <span class="text-base font-bold tracking-tight text-emphasis">LibreCourseUY</span>
    <span class="text-sm text-muted">© {year} | Open Source Education</span>
  </div>
</footer>
