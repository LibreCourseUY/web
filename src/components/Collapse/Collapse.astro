---
// Components
import Text from '@/components/Text/Text.astro';
interface Props {
	question: string;
	open?: boolean;
}

const { question, open = false } = Astro.props;
---

<div class:list={['faq-item group border-t border-line', { open }]}>
	<button
		class="faq-trigger w-full flex items-center justify-between gap-4 py-5 text-left cursor-pointer
      font-sans text-[15px] bg-transparent border-none
      transition-colors duration-200 hover:text-emphasis/80"
		aria-expanded={open ? 'true' : 'false'}
	>
		<span><Text variant="p">{question}</Text></span>
		<span
			class="faq-icon shrink-0 font-mono text-base text-muted/60
        transition-colors duration-300 ease-in-out
        group-[.open]:text-emphasis-secondary group-hover:text-emphasis"
			aria-hidden="true"
		>
			[+]
		</span>
	</button>

	<div
		class="faq-body grid grid-rows-[0fr] group-[.open]:grid-rows-[1fr]
      transition-[grid-template-rows] duration-350 ease-in-out"
	>
		<div class="overflow-hidden">
			<Text variant="p" className="pb-5 text-emphasis/80 leading-7">
				<slot />
			</Text>
		</div>
	</div>
</div>

<script>
	function setupFaq() {
		document.querySelectorAll<HTMLElement>('.faq-item').forEach((item) => {
			const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');

			trigger!.onclick = () => {
				const isOpen = item.classList.contains('open');

				document.querySelectorAll('.faq-item.open').forEach((el) => {
					el.classList.remove('open');
					el.querySelector<HTMLButtonElement>('.faq-trigger')?.setAttribute('aria-expanded', 'false');
				});

				if (!isOpen) {
					item.classList.add('open');
					trigger!.setAttribute('aria-expanded', 'true');
				}
			};
		});
	}

	setupFaq();
	document.addEventListener('astro:page-load', setupFaq);
</script>
