---
// Utils
import { cn } from '@/lib/utils';

export interface Props {
	className?: string;
	href?: string;
	disabled?: boolean;
	openInTab?: boolean;
}

const { href, className, disabled, openInTab = false } = Astro.props;
---

{
	disabled ? (
		<span
			class={cn(
				'anchor disabled relative text-2xl text-emphasis-secondary/60 cursor-default',
				className,
			)}
		>
			<slot />
		</span>
	) : (
		<a
			href={href}
			target={openInTab ? '_self' : '_blank'}
			class={cn(
				'anchor relative text-2xl text-emphasis-secondary cursor-pointer hover:text-emphasis-secondary/80',
				className,
			)}
		>
			<slot />
		</a>
	)
}
