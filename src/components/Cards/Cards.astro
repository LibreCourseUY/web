---
// Libreries
import { Image } from 'astro:assets';
// Components
import Text from '@/components/Text/Text.astro';
// Utils
import { cn } from '@/lib/utils';
import type { ProjectType } from '@/lib/types';
// Assets
import githubSVG from '@/assets/gh.svg';

export interface Props extends ProjectType {
  className?: string;
  index?: number;
}

const {
  title,
  autor,
  description,
  stack,
  image,
  index,
  className,
  pj_link,
} = Astro.props;

const default_colors = [
  "bg-surface-strong",
  "bg-surface-strong",
  "bg-surface-strong",
  "bg-surface-strong",
];
const colorIndex =
  !index && index !== 0 ? 1 : index % default_colors.length;
---

<div
  class={cn(
    "flex min-w-0 flex-row items-center gap-4 border border-line bg-surface p-4 transition-colors hover:border-emphasis-secondary/60",
    className,
  )}
>
  {
    image ? (
      <Image
        src={image}
        width={208}
        height={208}
        alt={title}
        class="h-24 w-24 shrink-0 object-cover md:h-36 md:w-36"
      />
    ) : (
      <div
        class={cn(
          default_colors[colorIndex],
          "hidden md:flex w-24 h-24 md:w-36 md:h-36 shrink-0 justify-center items-center",
        )}
      >
        <Image
          src={githubSVG}
          alt="no project reference"
          class="brightness-0 dark:invert opacity-80"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="flex min-w-0 flex-1 flex-col justify-center gap-y-3">
    <div class="flex w-full items-center justify-between gap-2">
      <h3 class="min-w-0 break-words text-lg font-bold">{title}</h3>
      <Text
        variant="a"
        aria-label='projct link'
        className="w-6 h-6 hover:bg-emphasis/10 hover:cursor-pointer flex items-center justify-center rounded-full"
        link={pj_link}

      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-4 h-4 text-muted"
        >
          <path d="M6 6v2h8.59L5 17.59 6.41 19 16 9.41V18h2V6z" />
        </svg>
      </Text>
    </div>

    <p class="break-words text-sm text-muted">{description}</p>

    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="mt-1 flex flex-wrap gap-2">
        {stack.map((tech) => (
          <span class="max-w-full break-all border border-line px-1.5 py-0.5 text-[0.7rem] uppercase tracking-wide text-muted">
            [{tech}]
          </span>
        ))}
      </div>
      <Text
        variant="a"
        link={autor.link}
        className="shrink-0 text-xs hover:underline text-emphasis-secondary"
      >
        @{autor.name.toLocaleLowerCase()}
      </Text>
    </div>
  </div>
  <slot />
</div>
