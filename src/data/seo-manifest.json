        {
          "@type": "FAQPage",
          "@id": "https://librecourse.uy/#faq",
          "url": "https://librecourse.uy/",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is LibreCourseUY?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "A non-profit initiative based in Uruguay that helps programmers, from aspiring developers to seasoned professionals, contribute to Free and Open Source Software."
              }
            },
            {
              "@type": "Question",
              "name": "Who can join?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Anyone, for free. Members are expected to follow our Code of Conduct, and those who wish to contribute must sign the CLA."
              }
            },
            {
              "@type": "Question",
              "name": "What does LibreCourseUY offer?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "A strong developer community with common goals, a space to learn and grow your career, and real projects worth putting on your CV."
              }
            },
            {
              "@type": "Question",
              "name": "How do I get started?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Read the Code of Conduct, then browse our First Issues list or find a repo you want to contribute to. If you're new, check out our Introductory Guide. It covers how to collaborate, learn, and get involved."
              }
            },
            {
              "@type": "Question",
              "name": "Why is everything in English?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Open source is a global conversation, and English is its common language. Writing issues, PRs, and documentation in English makes your contributions accessible to the entire FOSS community, not just Spanish speakers. It also prepares you for real-world collaboration on any project, anywhere."
              }
            },
            {
              "@type": "Question",
              "name": "Where can I find LibreCourseUY?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "{String(1).padStart(2, '0')} Contribute on GitHub {String(1).padStart(2, '0')} Join on our Discord server"
              }
            }
          ]
        }
      ]
    }
