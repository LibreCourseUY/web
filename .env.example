# Public feed URL for the awesome project list shown on /projects.
# Defaults to /api/feed (Cloudflare Pages function, edge-cached proxy to the
# awesome-librecourseuy feed). For local dev, either run
# `python3 scripts/serve-feed.py` (CORS) and point at http://localhost:8787/entries.json,
# or use the raw GitHub URL directly (GitHub serves CORS).
PUBLIC_AWESOME_FEED_URL=/api/feed
